	ListLayout.HorizontalAlignment = Enum.HorizontalAlignment.Left
	ListLayout.Padding = UDim.new(0, 3)
	ListLayout.Parent = List

	local activeRows = {}

	local function Refresh()
		local th = Library:GetTheme()
		local seenFlags = {}

		for flag, data in pairs(Library.Flags) do
			if type(data) == "table" and data.Key and data.Key ~= Enum.KeyCode.Unknown then
				local shouldShow = (data.Active == true)
				if data.ParentToggleFlag then
					shouldShow = (data.Active == true) and (Library.Flags[data.ParentToggleFlag] == true)
				end

				if shouldShow then
					seenFlags[flag] = true
					local isActive = (data.Active == true)
					local displayName = (data.Name or flag:gsub("_Key$", "")):lower()
					local badgeText = data.Badge or (data.Mode and tostring(data.Mode):lower()) or "toggle"

					local row = activeRows[flag]
					if not row then
						local RowPill = Instance.new("Frame")
						RowPill.Name = "Row_" .. flag
						RowPill.Size = UDim2.fromOffset(0, 22)
						RowPill.AutomaticSize = Enum.AutomaticSize.X
						RowPill.BackgroundColor3 = th.WindowBg
						RowPill.BackgroundTransparency = 1
						RowPill.Parent = List

						local RowCorner = Instance.new("UICorner")
						RowCorner.CornerRadius = UDim.new(0, 5)
						RowCorner.Parent = RowPill

						local RowStroke = Instance.new("UIStroke")
						RowStroke.Color = th.DropStroke or Color3.fromRGB(48, 48, 56)
						RowStroke.Transparency = 1
						RowStroke.Thickness = 1
						RowStroke.ApplyStrokeMode = Enum.ApplyStrokeMode.Border
						RowStroke.Parent = RowPill

						local RowPad = Instance.new("UIPadding")
						RowPad.PaddingTop = UDim.new(0, 2)
						RowPad.PaddingBottom = UDim.new(0, 2)
						RowPad.PaddingLeft = UDim.new(0, 8)
						RowPad.PaddingRight = UDim.new(0, 4)
						RowPad.Parent = RowPill

						local RowLayout = Instance.new("UIListLayout")
						RowLayout.FillDirection = Enum.FillDirection.Horizontal
						RowLayout.VerticalAlignment = Enum.VerticalAlignment.Center
						RowLayout.SortOrder = Enum.SortOrder.LayoutOrder
						RowLayout.Padding = UDim.new(0, 6)
						RowLayout.Parent = RowPill

						local Label = Instance.new("TextLabel")
						Label.Name = "Label"
						Label.LayoutOrder = 1
						Label.Size = UDim2.fromOffset(0, 18)
						Label.AutomaticSize = Enum.AutomaticSize.X
						Label.BackgroundTransparency = 1
						ApplyFont(Label, "Medium")
						Label.Text = displayName
						Label.TextColor3 = isActive and th.Text or th.TextDim
						Label.TextSize = 11
						Label.TextTransparency = 1
						Label.TextYAlignment = Enum.TextYAlignment.Center
						Label.Parent = RowPill

						local BadgeFrame = Instance.new("Frame")
						BadgeFrame.Name = "Badge"
						BadgeFrame.LayoutOrder = 2
						BadgeFrame.Size = UDim2.fromOffset(0, 16)
						BadgeFrame.AutomaticSize = Enum.AutomaticSize.X
						BadgeFrame.BackgroundColor3 = th.Accent
						BadgeFrame.BackgroundTransparency = 1
						BadgeFrame.Visible = true
						BadgeFrame.Parent = RowPill

						local BgCorner = Instance.new("UICorner")
						BgCorner.CornerRadius = UDim.new(0, 4)
						BgCorner.Parent = BadgeFrame

						local BgPad = Instance.new("UIPadding")
						BgPad.PaddingLeft = UDim.new(0, 5)
						BgPad.PaddingRight = UDim.new(0, 5)
						BgPad.Parent = BadgeFrame

						local BadgeLabel = Instance.new("TextLabel")
						BadgeLabel.Name = "BadgeLabel"
						BadgeLabel.Size = UDim2.fromOffset(0, 16)
						BadgeLabel.AutomaticSize = Enum.AutomaticSize.X
						BadgeLabel.BackgroundTransparency = 1
						ApplyFont(BadgeLabel, "Bold")
						BadgeLabel.Text = badgeText
						BadgeLabel.TextColor3 = th.Dark or Color3.fromRGB(17, 17, 17)
						BadgeLabel.TextSize = 10
						BadgeLabel.TextTransparency = 1
						BadgeLabel.TextYAlignment = Enum.TextYAlignment.Center
						BadgeLabel.Parent = BadgeFrame

						local RowScale = Instance.new("UIScale")
						RowScale.Scale = 0.80
						RowScale.Parent = RowPill

						Tween(RowPill, 0.20, { BackgroundTransparency = th.WindowTransparency }, Enum.EasingStyle.Quart, Enum.EasingDirection.Out)
						Tween(RowStroke, 0.20, { Transparency = 0.35 }, Enum.EasingStyle.Quart, Enum.EasingDirection.Out)
						Tween(RowScale, 0.20, { Scale = 1 }, Enum.EasingStyle.Back, Enum.EasingDirection.Out)
						Tween(Label, 0.20, { TextTransparency = 0 }, Enum.EasingStyle.Quart, Enum.EasingDirection.Out)
						Tween(BadgeFrame, 0.20, { BackgroundTransparency = 0 }, Enum.EasingStyle.Quart, Enum.EasingDirection.Out)
						Tween(BadgeLabel, 0.20, { TextTransparency = 0 }, Enum.EasingStyle.Quart, Enum.EasingDirection.Out)

						row = {
							Frame = RowPill,
							Scale = RowScale,
							Stroke = RowStroke,
							Label = Label,
							Badge = BadgeFrame,
							BadgeLabel = BadgeLabel,
							Pad = RowPad,
							lastActive = isActive,
							lastBadge = badgeText
						}
						activeRows[flag] = row
					else
						row.Label.Text = displayName
						if row.lastBadge ~= badgeText then
							row.lastBadge = badgeText
							row.BadgeLabel.Text = badgeText
						end

						if row.lastActive ~= isActive then
							row.lastActive = isActive
							Tween(row.Label, 0.16, { TextColor3 = isActive and th.Text or th.TextDim })
						end
					end
				end
			end
		end

		for flag, row in pairs(activeRows) do
			if not seenFlags[flag] then
				if row.Frame and row.Frame.Parent and not row.isRemoving then
					row.isRemoving = true
					Tween(row.Scale, 0.16, { Scale = 0.80 }, Enum.EasingStyle.Quart, Enum.EasingDirection.In)
					Tween(row.Frame, 0.16, { BackgroundTransparency = 1 }, Enum.EasingStyle.Quart, Enum.EasingDirection.In)
					Tween(row.Stroke, 0.16, { Transparency = 1 }, Enum.EasingStyle.Quart, Enum.EasingDirection.In)
					Tween(row.Label, 0.16, { TextTransparency = 1 }, Enum.EasingStyle.Quart, Enum.EasingDirection.In)
					Tween(row.Badge, 0.16, { BackgroundTransparency = 1 }, Enum.EasingStyle.Quart, Enum.EasingDirection.In)
					Tween(row.BadgeLabel, 0.16, { TextTransparency = 1 }, Enum.EasingStyle.Quart, Enum.EasingDirection.In)
					task.delay(0.16, function()
						if row.Frame and row.Frame.Parent then
							row.Frame:Destroy()
						end
					end)
				end
				activeRows[flag] = nil
			end
		end
	end

	table.insert(Library.KeybindListeners, Refresh)

	Library:OnThemeChange(function(th)
		HeaderPill.BackgroundColor3 = th.WindowBg
		HeaderPill.BackgroundTransparency = th.WindowTransparency
		HeaderStroke.Color = th.DropStroke or Color3.fromRGB(48, 48, 56)
		CmdBadge.BackgroundColor3 = th.Accent
		CmdIcon.TextColor3 = th.Dark or Color3.fromRGB(17, 17, 17)
		HeaderTitle.TextColor3 = th.Text
		for _, row in pairs(activeRows) do
			row.Frame.BackgroundColor3 = th.WindowBg
			row.Frame.BackgroundTransparency = th.WindowTransparency
			row.Stroke.Color = th.DropStroke or Color3.fromRGB(48, 48, 56)
			row.Badge.BackgroundColor3 = th.Accent
			row.BadgeLabel.TextColor3 = th.Dark or Color3.fromRGB(17, 17, 17)
			row.Label.TextColor3 = row.lastActive and th.Text or th.TextDim
		end
		Refresh()
	end)

	task.spawn(function()
		while ScreenGui and ScreenGui.Parent do
			pcall(Refresh)
			task.wait(0.2)
		end
	end)

	return KbFrame
end

