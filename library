local GarbageCollector = { Connections = {}, Instances = {}, Tweens = {} }
function GarbageCollector:AddConnection(conn) table.insert(self.Connections, conn); return conn end
function GarbageCollector:AddInstance(inst) table.insert(self.Instances, inst); return inst end
function GarbageCollector:AddTween(tw) table.insert(self.Tweens, tw); return tw end
function GarbageCollector:Cleanup()
	for _, c in ipairs(self.Connections) do pcall(function() c:Disconnect() end) end; table.clear(self.Connections)
	for _, t in ipairs(self.Tweens) do pcall(function() t:Cancel() end) end; table.clear(self.Tweens)
	for _, i in ipairs(self.Instances) do pcall(function() i:Destroy() end) end; table.clear(self.Instances)
end

