		end
		local isBottom = (bottomOffset ~= nil)

		local TabButton = nil
		local TabBtnIcon = nil

		local isFirstVisibleTab = (not isHiddenFromSidebar and not isBottom and Window.ActiveTab == nil)

		local topIndex = 0
		if not isHiddenFromSidebar and not isBottom then
			for _, t in ipairs(self.Tabs) do
				if not t.IsHidden and not t.IsBottom then
					topIndex = topIndex + 1
				end
			end
			topIndex = topIndex + 1
		end

		if not isHiddenFromSidebar then
			TabButton = Instance.new("TextButton")
