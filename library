							isModeOpen = false

							local curPos = ModePopup.Position
							local closeTargetPos = isOpenedUpward and UDim2.fromOffset(curPos.X.Offset, curPos.Y.Offset + popupH) or curPos

							Tween(MpStroke, 0.16, { Transparency = 1 }, Enum.EasingStyle.Quart, Enum.EasingDirection.In)
							Tween(ModePopup, 0.16, {
								Size = UDim2.fromOffset(popupW, 0),
								BackgroundTransparency = 1,
								Position = closeTargetPos
							}, Enum.EasingStyle.Quart, Enum.EasingDirection.In)

							task.delay(0.16, function()
