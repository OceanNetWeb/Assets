	local HealthFill = Instance.new("Frame")
	HealthFill.Name = "Fill"
	HealthFill.Size = UDim2.new(1, 0, 1, 0)
	HealthFill.BackgroundColor3 = self:GetTheme().Accent
	HealthFill.BorderSizePixel = 0
	HealthFill.Parent = HealthBarBg

	local HealthFillCorner = Instance.new("UICorner")
	HealthFillCorner.CornerRadius = UDim.new(0, 2)
	HealthFillCorner.Parent = HealthFill

	local currentTargetModel = nil
	local currentHealthPercent = 1
	local currentAvatarUserId = nil
	local isHidingTargetHUD = false
	local hideAnimToken = 0
	local _thumbCache = {}

	function Library:UpdateTargetHUD(targetObj)
		if not self.TargetFrame or not self.TargetGui or not self.TargetGui.Enabled or not self.TargetFrame.Visible then return end
		if targetObj and targetObj:IsA("Model") then
			local plr = Players:GetPlayerFromCharacter(targetObj)
			if not plr then
				plr = Players:FindFirstChild(targetObj.Name)
			end

			if plr and plr.UserId and plr.UserId > 0 then
				if currentAvatarUserId ~= plr.UserId then
					currentAvatarUserId = plr.UserId
					avatarShowingReal = true
					AvatarImage.ImageColor3 = Color3.fromRGB(255, 255, 255)
					local targetId = plr.UserId
					if _thumbCache[targetId] then
						AvatarImage.Image = _thumbCache[targetId]
					else
						task.spawn(function()
							local thumbType = Enum.ThumbnailType.HeadShot
							local thumbSize = Enum.ThumbnailSize.Size150x150
							local success, content = pcall(function()
								return Players:GetUserThumbnailAsync(targetId, thumbType, thumbSize)
							end)
							if success and content then
								_thumbCache[targetId] = content
								if currentAvatarUserId == targetId then
									AvatarImage.Image = content
								end
							end
						end)
					end
				end
			else
				if currentAvatarUserId ~= "default" then
					currentAvatarUserId = "default"
					avatarShowingReal = false
					AvatarImage.Image = "rbxassetid://10723375250"
					AvatarImage.ImageColor3 = Color3.fromRGB(255, 255, 255)
				end
			end

			local hum = targetObj:FindFirstChildOfClass("Humanoid")
			local name = targetObj.Name
			if hum then
				local health = math.max(0, hum.Health)
				local maxHealth = hum.MaxHealth > 0 and hum.MaxHealth or 100
				local pct = math.clamp(health / maxHealth, 0, 1)

				NameText.Text = name
				HealthText.Text = tostring(math.floor(health + 0.5))

				local forceUpdate = (currentTargetModel ~= targetObj)
				if forceUpdate or math.abs(currentHealthPercent - pct) > 0.001 then
					currentHealthPercent = pct
					HealthFill.Size = forceUpdate and UDim2.new(pct, 0, 1, 0) or HealthFill.Size
					Tween(HealthFill, 0.15, { Size = UDim2.new(pct, 0, 1, 0) }, Enum.EasingStyle.Quart, Enum.EasingDirection.Out)
				end
				currentTargetModel = targetObj
			else
				NameText.Text = name
				HealthText.Text = "100"
				if currentTargetModel ~= targetObj then
					currentHealthPercent = 1
					HealthFill.Size = UDim2.new(1, 0, 1, 0)
					Tween(HealthFill, 0.15, { Size = UDim2.new(1, 0, 1, 0) }, Enum.EasingStyle.Quart, Enum.EasingDirection.Out)
				end
				currentTargetModel = targetObj
			end
		else
			if not Library.IsOpen then
				-- Keep last target details active while HUD is fading out
			else
				currentTargetModel = nil
				if currentAvatarUserId ~= "default" then
					currentAvatarUserId = "default"
					AvatarImage.Image = "rbxassetid://10723375250"
					AvatarImage.ImageColor3 = self:GetTheme().Dark or Color3.fromRGB(17, 17, 17)
				end
				NameText.Text = "Prototype"
				HealthText.Text = "100"
				currentHealthPercent = 1
				Tween(HealthFill, 0.15, { Size = UDim2.new(1, 0, 1, 0) }, Enum.EasingStyle.Quart, Enum.EasingDirection.Out)
			end
		end
	end

	function Library:SetTargetHUDVisible(state)
		if not self.TargetFrame or not self.TargetGui then return end
		local th = self:GetTheme()
		local bubbles = { AvatarBubble, InfoBubble, StatsBubble }
		local strokes = { AvatarStroke, InfoStroke, StatsStroke }

		hideAnimToken = hideAnimToken + 1
		local currentToken = hideAnimToken

		if state then
			isHidingTargetHUD = false
			self.TargetGui.Enabled = true
			self.TargetFrame.Visible = true

			-- Animate HudScale back to 1.0 (Quart Out)
			Tween(HudScale, 0.15, { Scale = 1 }, Enum.EasingStyle.Quart, Enum.EasingDirection.Out)

			for _, b in ipairs(bubbles) do
				Tween(b, 0.15, { BackgroundTransparency = th.WindowTransparency }, Enum.EasingStyle.Quart, Enum.EasingDirection.Out)
			end
			for _, s in ipairs(strokes) do
				Tween(s, 0.15, { Transparency = 0.35 }, Enum.EasingStyle.Quart, Enum.EasingDirection.Out)
			end
			Tween(AvatarInner, 0.15, { BackgroundTransparency = 0 }, Enum.EasingStyle.Quart, Enum.EasingDirection.Out)
			Tween(AvatarImage, 0.15, { ImageTransparency = 0 }, Enum.EasingStyle.Quart, Enum.EasingDirection.Out)
			Tween(TargetBadge, 0.15, { BackgroundTransparency = 0 }, Enum.EasingStyle.Quart, Enum.EasingDirection.Out)
			Tween(TargetTag, 0.15, { TextTransparency = 0 }, Enum.EasingStyle.Quart, Enum.EasingDirection.Out)
			Tween(HealthBarBg, 0.15, { BackgroundTransparency = 0.3 }, Enum.EasingStyle.Quart, Enum.EasingDirection.Out)
			Tween(HealthFill, 0.15, { BackgroundTransparency = 0 }, Enum.EasingStyle.Quart, Enum.EasingDirection.Out)
			for _, d in ipairs(self.TargetFrame:GetDescendants()) do
				if d:IsA("TextLabel") and d ~= TargetTag then
					Tween(d, 0.15, { TextTransparency = 0 }, Enum.EasingStyle.Quart, Enum.EasingDirection.Out)
				end
			end
		else
			isHidingTargetHUD = true
			Tween(HudScale, 0.15, { Scale = 0.85 }, Enum.EasingStyle.Quart, Enum.EasingDirection.In)
			for _, b in ipairs(bubbles) do
				Tween(b, 0.15, { BackgroundTransparency = 1 }, Enum.EasingStyle.Quart, Enum.EasingDirection.In)
			end
			for _, s in ipairs(strokes) do
				Tween(s, 0.15, { Transparency = 1 }, Enum.EasingStyle.Quart, Enum.EasingDirection.In)
			end
			Tween(AvatarInner, 0.15, { BackgroundTransparency = 1 }, Enum.EasingStyle.Quart, Enum.EasingDirection.In)
			Tween(AvatarImage, 0.15, { ImageTransparency = 1 }, Enum.EasingStyle.Quart, Enum.EasingDirection.In)
			Tween(TargetBadge, 0.15, { BackgroundTransparency = 1 }, Enum.EasingStyle.Quart, Enum.EasingDirection.In)
			Tween(TargetTag, 0.15, { TextTransparency = 1 }, Enum.EasingStyle.Quart, Enum.EasingDirection.In)
			Tween(HealthBarBg, 0.15, { BackgroundTransparency = 1 }, Enum.EasingStyle.Quart, Enum.EasingDirection.In)
			Tween(HealthFill, 0.15, { BackgroundTransparency = 1 }, Enum.EasingStyle.Quart, Enum.EasingDirection.In)
			for _, d in ipairs(self.TargetFrame:GetDescendants()) do
				if d:IsA("TextLabel") then
					Tween(d, 0.15, { TextTransparency = 1 }, Enum.EasingStyle.Quart, Enum.EasingDirection.In)
				end
			end
			task.delay(0.15, function()
				if hideAnimToken == currentToken and isHidingTargetHUD then
					if self.TargetFrame then self.TargetFrame.Visible = false end
					if self.TargetGui then self.TargetGui.Enabled = false end
					isHidingTargetHUD = false
				end
			end)
		end
	end

	MakeDraggable(TargetFrame, TargetFrame)

	Library:OnThemeChange(function(th)
		local bubbles = { AvatarBubble, InfoBubble, StatsBubble }
		local strokes = { AvatarStroke, InfoStroke, StatsStroke }
		for _, b in ipairs(bubbles) do
			b.BackgroundColor3 = th.WindowBg
			b.BackgroundTransparency = th.WindowTransparency
		end
		for _, s in ipairs(strokes) do
			s.Color = th.DropStroke or Color3.fromRGB(48, 48, 56)
		end
		AvatarInner.BackgroundColor3 = th.Accent
		-- Only reset avatar icon color if NOT showing a real player thumbnail
		if not avatarShowingReal then
			AvatarImage.ImageColor3 = Color3.fromRGB(255, 255, 255)
		end
		TargetBadge.BackgroundColor3 = th.Accent
		TargetTag.TextColor3 = th.Dark or Color3.fromRGB(17, 17, 17)
		NameText.TextColor3 = th.Text
		HealthText.TextColor3 = th.Text
		HealthBarBg.BackgroundColor3 = th.DropStroke or Color3.fromRGB(48, 48, 56)
		HealthFill.BackgroundColor3 = th.Accent
	end)

	return TargetFrame
end

