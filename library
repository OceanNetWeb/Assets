					ListFrame.Parent = DropContainer

					local ListPadding = Instance.new("UIPadding")
					ListPadding.PaddingTop = UDim.new(0, 2)
					ListPadding.PaddingBottom = UDim.new(0, 4)
					ListPadding.PaddingLeft = UDim.new(0, 4)
					ListPadding.PaddingRight = UDim.new(0, 4)
					ListPadding.Parent = ListFrame

					local ListLayout = Instance.new("UIListLayout")
					ListLayout.SortOrder = Enum.SortOrder.LayoutOrder
					ListLayout.Padding = UDim.new(0, 2)
					ListLayout.Parent = ListFrame

					local isDropOpen = false

					local function CloseDropdown()
						if not isDropOpen then return end
						isDropOpen = false
						DisplayLabel.TextColor3 = Library:GetTheme().Text
						DisplayLabel.TextTransparency = 0
						Tween(Arrow, 0.18, { Rotation = 0 }, Enum.EasingStyle.Quart, Enum.EasingDirection.Out)
						Tween(DropContainer, 0.18, { Size = UDim2.new(1, -8, 0, 26) }, Enum.EasingStyle.Quart, Enum.EasingDirection.In)
						Tween(DropdownCard, 0.18, { Size = UDim2.new(1, 0, 0, 48) }, Enum.EasingStyle.Quart, Enum.EasingDirection.In)
						task.delay(0.18, function()
							if not isDropOpen then
								DropContainer.ZIndex = 12
								DropdownCard.ZIndex = 10
							end
						end)
					end

					local function OpenDropdown()
						if isDropOpen then return end
						CloseAllPopups()
						isDropOpen = true
						DropdownCard.ZIndex = 90
						DropContainer.ZIndex = 90
						DisplayLabel.TextColor3 = Library:GetTheme().Text
						DisplayLabel.TextTransparency = 0

						local targetHeight = 26 + math.min(#items * 24 + 6, 140)
						Tween(Arrow, 0.22, { Rotation = 180 }, Enum.EasingStyle.Quart, Enum.EasingDirection.Out)
						Tween(DropContainer, 0.22, { Size = UDim2.new(1, -8, 0, targetHeight) }, Enum.EasingStyle.Quart, Enum.EasingDirection.Out)
						Tween(DropdownCard, 0.22, { Size = UDim2.new(1, 0, 0, 22 + targetHeight) }, Enum.EasingStyle.Quart, Enum.EasingDirection.Out)
					end

					local function ToggleDropdown()
						if isDropOpen then
							CloseDropdown()
						else
							OpenDropdown()
						end
					end

					if dependsOn then
						local flagsToWatch = (type(dependsOn) == "table") and dependsOn or { dependsOn }
						for _, f in ipairs(flagsToWatch) do
							Library:OnToggleChange(f, function()
								if not checkDependsActive(dependsOn) then
									if isDropOpen then
										-- hookDepends handles DropdownCard tween; we handle DropContainer and state
										isDropOpen = false
										DropdownCard.ZIndex = 10
										Tween(Arrow, 0.18, { Rotation = 0 }, Enum.EasingStyle.Quart, Enum.EasingDirection.Out)
										Tween(DropContainer, 0.18, { Size = UDim2.new(1, -8, 0, 26) }, Enum.EasingStyle.Quart, Enum.EasingDirection.In)
										task.delay(0.18, function()
											DropContainer.ZIndex = 12
										end)
									end
								end
							end)
						end
					end

					HeaderBtn.MouseButton1Click:Connect(ToggleDropdown)

					local itemElements = {}

					local function AnimateDisplayLabel(newText)
						DisplayLabel.Text = newText
						DisplayLabel.TextColor3 = Library:GetTheme().Text
						DisplayLabel.TextTransparency = 0
					end

					local function SetVal(newVal, instant)
						currentVal = newVal
						Library.Flags[flag] = currentVal
						DisplayLabel.Text = multi and (#currentVal > 0 and table.concat(currentVal, ", ") or "None") or tostring(currentVal)
						if DisplayDot and itemColors then
							local dotColor = GetItemColor(currentVal)
							if dotColor then DisplayDot.BackgroundColor3 = dotColor end
						end
						for it, elem in pairs(itemElements) do
							local sel = multi and table.find(currentVal, it) or (currentVal == it)
							elem.Check:SetAttribute("OrigImgTrans", sel and 0 or 1)
							local thAccent = Library:GetTheme().Accent
							local thText = Library:GetTheme().Text
							if instant then
								elem.Check.ImageTransparency = sel and 0 or 1
								elem.Check.ImageColor3 = thAccent
								if elem.Dot then
									elem.Dot.Position = sel and UDim2.new(0, 22, 0.5, -4) or UDim2.new(0, 8, 0.5, -4)
									elem.Text.Position = sel and UDim2.fromOffset(36, 0) or UDim2.fromOffset(22, 0)
								else
									elem.Text.Position = sel and UDim2.fromOffset(22, 0) or UDim2.fromOffset(8, 0)
								end
								elem.Text.TextColor3 = sel and thAccent or thText
							else
								Tween(elem.Check, 0.2, { ImageTransparency = sel and 0 or 1, ImageColor3 = thAccent }, Enum.EasingStyle.Quart, Enum.EasingDirection.Out)
								if elem.Dot then
									Tween(elem.Dot, 0.2, {
										Position = sel and UDim2.new(0, 22, 0.5, -4) or UDim2.new(0, 8, 0.5, -4)
									}, Enum.EasingStyle.Quart, Enum.EasingDirection.Out)
									Tween(elem.Text, 0.2, {
										Position = sel and UDim2.fromOffset(36, 0) or UDim2.fromOffset(22, 0),
										TextColor3 = sel and thAccent or thText
									}, Enum.EasingStyle.Quart, Enum.EasingDirection.Out)
								else
									Tween(elem.Text, 0.2, {
										Position = sel and UDim2.fromOffset(22, 0) or UDim2.fromOffset(8, 0),
										TextColor3 = sel and thAccent or thText
									}, Enum.EasingStyle.Quart, Enum.EasingDirection.Out)
								end
							end
						end
						pcall(callback, currentVal)
					end

					local isUpdatingVal = false

					local function HandleSelect(item)
						if isUpdatingVal then return end
						isUpdatingVal = true
						if multi then
							local idx = table.find(currentVal, item)
							if idx then
								table.remove(currentVal, idx)
							else
								table.insert(currentVal, item)
							end
							SetVal(currentVal, false)
						else
							SetVal(item, false)
						end
						callback(currentVal)
						isUpdatingVal = false
					end

					local function RebuildItems()
						for _, child in ipairs(ListFrame:GetChildren()) do
							if child:IsA("TextButton") then child:Destroy() end
						end
						itemElements = {}

						for _, item in ipairs(items) do
							local isSelected = multi and table.find(currentVal, item) or (currentVal == item)
							local dotColor = GetItemColor(item)

							local ItemBtn = Instance.new("TextButton")
							ItemBtn.Name = "Item_" .. tostring(item)
							ItemBtn.Size = UDim2.new(1, 0, 0, 22)
							ItemBtn.BackgroundColor3 = Library:GetTheme().Card
							ItemBtn.BackgroundTransparency = 1
							ItemBtn.Text = ""
							ItemBtn.AutoButtonColor = false
							ItemBtn.ZIndex = 98
							ItemBtn.Parent = ListFrame

							local ItemCorner = Instance.new("UICorner")
							ItemCorner.CornerRadius = UDim.new(0, 4)
							ItemCorner.Parent = ItemBtn

							local ItemCheck = Instance.new("ImageLabel")
							ItemCheck.Name = "Check"
							ItemCheck.Size = UDim2.fromOffset(12, 12)
							ItemCheck.Position = UDim2.new(0, 6, 0.5, -6)
							ItemCheck.BackgroundTransparency = 1
							ItemCheck.Image = Library.Icons.Check
							ItemCheck.ImageColor3 = Library:GetTheme().Accent
							ItemCheck.ImageTransparency = isSelected and 0 or 1
							ItemCheck:SetAttribute("OrigImgTrans", isSelected and 0 or 1)
							ItemCheck.ZIndex = 99
							ItemCheck.Parent = ItemBtn

							local ItemDot = nil
							if dotColor then
								ItemDot = Instance.new("Frame")
								ItemDot.Name = "Dot"
								ItemDot.Size = UDim2.fromOffset(8, 8)
								ItemDot.Position = isSelected and UDim2.new(0, 22, 0.5, -4) or UDim2.new(0, 8, 0.5, -4)
								ItemDot.BackgroundColor3 = dotColor
								ItemDot.ZIndex = 99
								ItemDot.Parent = ItemBtn

								local DotCorner = Instance.new("UICorner")
								DotCorner.CornerRadius = UDim.new(1, 0)
								DotCorner.Parent = ItemDot
							end

							local ItemText = Instance.new("TextLabel")
							ItemText.Name = "Label"
							ItemText.Size = dotColor and UDim2.new(1, -40, 1, 0) or UDim2.new(1, -24, 1, 0)
							ItemText.Position = dotColor and (isSelected and UDim2.fromOffset(36, 0) or UDim2.fromOffset(22, 0)) or (isSelected and UDim2.fromOffset(22, 0) or UDim2.fromOffset(8, 0))
							ItemText.BackgroundTransparency = 1
							ApplyFont(ItemText, "Medium")
							ItemText.Text = tostring(item)
							ItemText.TextColor3 = isSelected and Library:GetTheme().Accent or Library:GetTheme().Text
							ItemText.TextSize = 11
							ItemText.TextXAlignment = Enum.TextXAlignment.Left
							ItemText.ZIndex = 99
							ItemText.Parent = ItemBtn

							itemElements[item] = { Btn = ItemBtn, Check = ItemCheck, Text = ItemText, Dot = ItemDot }

							ItemBtn.MouseButton1Click:Connect(function()
								HandleSelect(item)
							end)

							ItemBtn.MouseEnter:Connect(function()
								if not Library.IsOpen or isToggling then return end
								Tween(ItemBtn, 0.1, { BackgroundTransparency = 0.6 })
							end)
							ItemBtn.MouseLeave:Connect(function()
								if not Library.IsOpen or isToggling then return end
								Tween(ItemBtn, 0.1, { BackgroundTransparency = 1 })
							end)
						end
					end

					RebuildItems()

					Library:OnThemeChange(function(th)
						Title.TextColor3 = th.Text
						DropContainer.BackgroundColor3 = th.Elevated
						DropContainer.BackgroundTransparency = th.ElevatedTransparency
						DropStroke.Color = th.DropStroke or Color3.fromRGB(48, 48, 54)
						DisplayLabel.TextColor3 = th.Text
						Arrow.ImageColor3 = th.TextDim
						if DisplayDot and itemColors then
							local c = GetItemColor(currentVal)
							if c then DisplayDot.BackgroundColor3 = c end
						end
						for it, elem in pairs(itemElements) do
							local sel = multi and table.find(currentVal, it) or (currentVal == it)
							elem.Check.ImageColor3 = th.Accent
							elem.Text.TextColor3 = sel and th.Accent or th.Text
						end
					end)

					Library.ControlSetters[flag] = SetVal

					table.insert(Library.SearchRegistry, {
						Name = name,
						Category = sectionName,
						Tab = TabObj,
						Subtab = SubtabObj,
						Element = DropdownCard
					})

					return {
						Set = SetVal,
						Get = function() return currentVal end,
						SetItems = function(newItems)
							items = newItems or {}
							if not multi and not table.find(items, currentVal) and #items > 0 then
								SetVal(items[1], false)
							end
							RebuildItems()
						end,
						Refresh = function(newItems)
							items = newItems or {}
							if not multi and not table.find(items, currentVal) and #items > 0 then
								SetVal(items[1], false)
							end
							RebuildItems()
						end
					}
				end

