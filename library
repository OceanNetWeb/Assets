							}

							MBtn.MouseEnter:Connect(function()
								if not Library.IsOpen or isToggling then return end
								if mode ~= m then
									Tween(MBtn, 0.12, { BackgroundTransparency = 0.6 })
								end
							end)

							MBtn.MouseLeave:Connect(function()
								if not Library.IsOpen or isToggling then return end
								Tween(MBtn, 0.12, { BackgroundTransparency = (mode == m) and 0.8 or 1 })
							end)

							MBtn.MouseButton1Click:Connect(function()
								mode = m
								if mode == "Always" then
									isToggledActive = true
								elseif mode == "Hold" then
									isHolding = false
								end
								UpdateModeVisuals(false)
								UpdateKeybindRuntime()
							end)
						end

						KeyBtn.MouseButton1Click:Connect(function()
							listening = true
							UpdateKeyDisplay("...", true)
						end)

						KeyBtn.MouseButton2Click:Connect(function()
							if isDropOpen then return end
							if isModeOpen then
								CloseAllPopups()
							else
								UpdateModeVisuals(true)
								local abs = KeyBtn.AbsolutePosition
								local mainAbs = MainFrame.AbsolutePosition
								local btnW = KeyBtn.AbsoluteSize.X
								local btnH = KeyBtn.AbsoluteSize.Y

								local posX = math.clamp((abs.X - mainAbs.X) + btnW - popupW, 8, MainFrame.AbsoluteSize.X - popupW - 8)
								local posY = (abs.Y - mainAbs.Y) + btnH + 4
								isOpenedUpward = false
								if posY + popupH > MainFrame.AbsoluteSize.Y - 10 then
									posY = (abs.Y - mainAbs.Y) - popupH - 4
									isOpenedUpward = true
								end

								isModeOpen = true

								if isOpenedUpward then
									ModePopup.Position = UDim2.fromOffset(posX, posY + popupH)
									ModePopup.Size = UDim2.fromOffset(popupW, 0)
									ModePopup.BackgroundTransparency = 1
									MpStroke.Transparency = 1
									ModePopup.Visible = true

									OpenPopup(ModePopup, CloseModePopup)

									Tween(ModePopup, 0.22, {
										Position = UDim2.fromOffset(posX, posY),
										Size = UDim2.fromOffset(popupW, popupH),
										BackgroundTransparency = 0.05
									}, Enum.EasingStyle.Quart, Enum.EasingDirection.Out)
									Tween(MpStroke, 0.22, { Transparency = 0.35 }, Enum.EasingStyle.Quart, Enum.EasingDirection.Out)
								else
									ModePopup.Position = UDim2.fromOffset(posX, posY)
									ModePopup.Size = UDim2.fromOffset(popupW, 0)
									ModePopup.BackgroundTransparency = 1
									MpStroke.Transparency = 1
									ModePopup.Visible = true

									OpenPopup(ModePopup, CloseModePopup)

									Tween(ModePopup, 0.22, {
										Size = UDim2.fromOffset(popupW, popupH),
										BackgroundTransparency = 0.05
									}, Enum.EasingStyle.Quart, Enum.EasingDirection.Out)
									Tween(MpStroke, 0.22, { Transparency = 0.35 }, Enum.EasingStyle.Quart, Enum.EasingDirection.Out)
								end
							end
						end)

						local kbRecord = {
							Flag = kbFlag,
							ParentFlag = flag,
							GetKey = function() return key end,
							GetMode = function() return mode end,
							GetMaster = function() return masterEnabled end,
							GetIsListening = function() return listening end,
							GetActive = function() return isToggledActive end,
							SetActive = function(val) isToggledActive = val end,
							SetHolding = function(val) isHolding = val end,
							Update = UpdateKeybindRuntime
						}
						table.insert(Library.KeybindRegistry, kbRecord)

						local kbConn1 = UserInputService.InputBegan:Connect(function(input, gpe)
							if listening and not gpe then
								if input.UserInputType == Enum.UserInputType.Keyboard then
									if input.KeyCode == Enum.KeyCode.Escape then
										key = Enum.KeyCode.Unknown
									else
										key = input.KeyCode
									end
									listening = false
									UpdateKeyDisplay(FormatKey(key), false)
									UpdateKeybindRuntime()
								elseif input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.MouseButton2 or input.UserInputType == Enum.UserInputType.MouseButton3 then
									key = input.UserInputType
									listening = false
									UpdateKeyDisplay(FormatKey(key), false)
									UpdateKeybindRuntime()
								end
							elseif not listening and not gpe and key ~= Enum.KeyCode.Unknown and (input.KeyCode == key or input.UserInputType == key) then
								if mode == "Toggle" then
									local allMatching = {}
									local allActive = true
									for _, rec in ipairs(Library.KeybindRegistry) do
										if rec.GetKey() == key and rec.GetMode() == "Toggle" and rec.GetMaster() then
											table.insert(allMatching, rec)
											if not rec.GetActive() then
												allActive = false
											end
										end
									end

									if #allMatching > 0 and allMatching[1] == kbRecord then
										local targetActive = not allActive
										for _, rec in ipairs(allMatching) do
											rec.SetActive(targetActive)
											rec.Update()
										end
									end
								elseif mode == "Hold" then
									local allMatching = {}
									for _, rec in ipairs(Library.KeybindRegistry) do
										if rec.GetKey() == key and rec.GetMode() == "Hold" and rec.GetMaster() then
											table.insert(allMatching, rec)
										end
									end
									if #allMatching > 0 and allMatching[1] == kbRecord then
										for _, rec in ipairs(allMatching) do
											rec.SetHolding(true)
											rec.Update()
										end
									end
								end
							end
						end)
						GarbageCollector:AddConnection(kbConn1)

						local kbConn2 = UserInputService.InputEnded:Connect(function(input)
							if not listening and mode == "Hold" and key ~= Enum.KeyCode.Unknown and (input.KeyCode == key or input.UserInputType == key) then
								local allMatching = {}
								for _, rec in ipairs(Library.KeybindRegistry) do
									if rec.GetKey() == key and rec.GetMode() == "Hold" then
										table.insert(allMatching, rec)
									end
								end
								if #allMatching > 0 and allMatching[1] == kbRecord then
									for _, rec in ipairs(allMatching) do
										rec.SetHolding(false)
										rec.Update()
									end
								end
							end
						end)
						GarbageCollector:AddConnection(kbConn2)

						Library:OnThemeChange(function(th)
							KeyBtn.BackgroundColor3 = th.Elevated
							KeyLabel.TextColor3 = listening and th.Accent or th.TextDim
							KeyStroke.Color = th.DropStroke or Color3.fromRGB(48, 48, 54)
							ModePopup.BackgroundColor3 = th.Elevated
							MpStroke.Color = th.DropStroke or Color3.fromRGB(48, 48, 54)
							UpdateModeVisuals(true)
						end)

						Library.ControlSetters[kbFlag] = function(data)
							if type(data) == "table" then
								if data.Key then
									if typeof(data.Key) == "EnumItem" then
										key = data.Key
									elseif type(data.Key) == "string" and Enum.KeyCode[data.Key] then
										key = Enum.KeyCode[data.Key]
									end
								end
								if data.Mode then mode = data.Mode end
								if mode == "Toggle" then
									isToggledActive = false
								elseif mode == "Always" then
									isToggledActive = masterEnabled
								elseif mode == "Hold" then
									isHolding = false
								end
							elseif typeof(data) == "EnumItem" then
								key = data
								if mode == "Toggle" then isToggledActive = false elseif mode == "Hold" then isHolding = false end
							elseif type(data) == "string" and Enum.KeyCode[data] then
								key = Enum.KeyCode[data]
								if mode == "Toggle" then isToggledActive = false elseif mode == "Hold" then isHolding = false end
							end
							
							UpdateKeyDisplay(FormatKey(key), false)
							UpdateModeVisuals(true)
							UpdateKeybindRuntime()
						end

						return KeyBtn
					end

