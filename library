					local SwatchStroke = Instance.new("UIStroke")
					SwatchStroke.Name = "SwatchStroke"
					SwatchStroke.Color = Library:GetTheme().DropStroke or Color3.fromRGB(48, 48, 54)
					SwatchStroke.Thickness = 1
					SwatchStroke.ApplyStrokeMode = Enum.ApplyStrokeMode.Border
					SwatchStroke.Parent = Swatch

					colData.Box = Swatch
					colData.Callback = function(c, a)
						Swatch.BackgroundColor3 = c
						Library.Flags[flag] = c
						callback(c, a, colData)
					end

					if colData.Mode == "RGB" or colData.Mode == "Seq" then
						Library.AnimatedColors[colData.AnimId] = colData
					end

					local activePickerPopup = nil
					Swatch.MouseButton1Click:Connect(function()
						if activePickerPopup and activePickerPopup.Parent and activePickerPopup.Visible then
							CloseAllPopups()
							activePickerPopup = nil
						else
							activePickerPopup = CreateColorPickerPopup(Swatch, colData, 150)
						end
					end)

					Library:OnThemeChange(function(th)
						Title.TextColor3 = th.Text
						SwatchStroke.Color = th.DropStroke or Color3.fromRGB(48, 48, 54)
					end)

					local function SetColor(val, alpha, mode, speed, seed, stops)
						local c = val
						if type(val) == "table" and val.R and val.G and val.B then
							c = Color3.fromRGB(val.R, val.G, val.B)
						end
						if typeof(c) == "Color3" then
							local h, s, v = c:ToHSV()
							colData.Color = c
							colData.Hue = h
							colData.Sat = s
							colData.Val = v
						end
						if alpha then colData.Alpha = alpha end
						if mode then colData.Mode = mode end
						if speed then colData.Speed = speed end
						if seed then colData.Seed = seed end
						if stops then colData.Stops = stops end

						Swatch.BackgroundColor3 = colData.Color
						Library.Flags[flag] = colData.Color
						callback(colData.Color, colData.Alpha, colData)

						if colData.Mode == "RGB" or colData.Mode == "Seq" then
							Library.AnimatedColors[colData.AnimId] = colData
						else
							Library.AnimatedColors[colData.AnimId] = nil
						end
					end

					Library.ControlSetters[flag] = SetColor

					table.insert(Library.SearchRegistry, {
						Name = name,
						Category = sectionName,
						Tab = TabObj,
						Subtab = SubtabObj,
						Element = CpRow
					})

					return {
						Set = SetColor,
						Get = function() return colData end,
						GetColor = function() return colData.Color end,
						Row = CpRow
					}
				end

				----------------------------------------------------------------
				-- 3. STANDALONE KEYBIND (ELEGANT ROUNDED PILL BADGE)
				----------------------------------------------------------------
				function SectionObj:CreateKeybind(kbConfig)
					kbConfig = kbConfig or {}
					local name = kbConfig.Name or "Keybind"
					local flag = kbConfig.Flag or name
					local default = kbConfig.Default or Enum.KeyCode.Unknown
					local callback = kbConfig.Callback or function() end

					local key = default
					local listening = false
					Library.Flags[flag] = key

					local function FormatKey(k)
						if not k or k == Enum.KeyCode.Unknown then return "-" end
						if typeof(k) == "EnumItem" then
							if k.EnumType == Enum.KeyCode then
								local str = k.Name:upper()
								if str == "RIGHTALT" then return "RALT" end
								if str == "LEFTALT" then return "LALT" end
								if str == "RIGHTCONTROL" then return "RCTRL" end
								if str == "LEFTCONTROL" then return "LCTRL" end
								if str == "RIGHTSHIFT" then return "RSHIFT" end
								if str == "LEFTSHIFT" then return "LSHIFT" end
								if str == "CAPSLOCK" then return "CAPS" end
								return str
							elseif k.EnumType == Enum.UserInputType then
								if k == Enum.UserInputType.MouseButton1 then return "M1" end
								if k == Enum.UserInputType.MouseButton2 then return "M2" end
								if k == Enum.UserInputType.MouseButton3 then return "M3" end
							end
						end
						local s = tostring(k):gsub("Enum%.KeyCode%.", ""):gsub("Enum%.UserInputType%.", ""):upper()
						return (s ~= "" and s ~= "UNKNOWN") and s or "-"
					end

					local KeybindRow = Instance.new("Frame")
					KeybindRow.Name = "KeybindRow_" .. name
					KeybindRow.Size = UDim2.new(1, 0, 0, 24)
					KeybindRow.BackgroundTransparency = 1
					KeybindRow.Parent = SectionCard

					local Label = Instance.new("TextLabel")
					Label.Name = "Label"
					Label.Size = UDim2.new(1, -70, 1, 0)
					Label.Position = UDim2.fromOffset(0, 0)
					Label.BackgroundTransparency = 1
					ApplyFont(Label, "Medium")
					Label.Text = name
					Label.TextColor3 = Library:GetTheme().Text
					Label.TextSize = 12
					Label.TextXAlignment = Enum.TextXAlignment.Left
					Label.Parent = KeybindRow

					local KeyBtn = Instance.new("TextButton")
					KeyBtn.Name = "KeyBtn"
					KeyBtn.Size = UDim2.fromOffset(20, 20)
					KeyBtn.Position = UDim2.new(1, 0, 0.5, 0)
					KeyBtn.AnchorPoint = Vector2.new(1, 0.5)
					KeyBtn.BackgroundColor3 = Library:GetTheme().Elevated
					KeyBtn.BackgroundTransparency = Library:GetTheme().ElevatedTransparency
					KeyBtn.Text = ""
					KeyBtn.AutoButtonColor = false
					KeyBtn.Parent = KeybindRow

					local KeyCorner = Instance.new("UICorner")
					KeyCorner.CornerRadius = UDim.new(0, 4)
					KeyCorner.Parent = KeyBtn

					local KeyStroke = Instance.new("UIStroke")
					KeyStroke.Name = "KeyStroke"
					KeyStroke.Color = Library:GetTheme().DropStroke or Color3.fromRGB(48, 48, 54)
					KeyStroke.Transparency = 0.35
					KeyStroke:SetAttribute("OrigStrokeTrans", 0.35)
					KeyStroke.Thickness = 1
					KeyStroke.ApplyStrokeMode = Enum.ApplyStrokeMode.Border
					KeyStroke.Parent = KeyBtn

					local KeyLabel = Instance.new("TextLabel")
					KeyLabel.Name = "KeyLabel"
					KeyLabel.Size = UDim2.fromScale(1, 1)
					KeyLabel.Position = UDim2.fromOffset(0, 0)
					KeyLabel.BackgroundTransparency = 1
					ApplyFont(KeyLabel, "Bold")
					KeyLabel.TextColor3 = Library:GetTheme().TextDim
					KeyLabel.TextSize = 10
					KeyLabel.TextXAlignment = Enum.TextXAlignment.Center
					KeyLabel.TextYAlignment = Enum.TextYAlignment.Center
					KeyLabel.Parent = KeyBtn

					local function UpdateKeyDisplay(rawStr, isPrompt)
						KeyLabel.Text = rawStr
						local textW = math.ceil(TextService:GetTextSize(rawStr, 10, FontManager.FallbackBold, Vector2.new(1000, 20)).X)
						local finalW = math.max(20, textW + 8)
						KeyBtn.Size = UDim2.fromOffset(finalW, 20)
						if isPrompt then
							KeyLabel.TextColor3 = Library:GetTheme().Accent
						else
							KeyLabel.TextColor3 = Library:GetTheme().TextDim
						end
					end

					UpdateKeyDisplay(FormatKey(key), false)

					KeyBtn.MouseEnter:Connect(function()
						if not Library.IsOpen or isToggling then return end
						Tween(KeyStroke, 0.15, { Transparency = 0.1 })
						Tween(KeyBtn, 0.15, { BackgroundTransparency = 0.6 })
					end)
					KeyBtn.MouseLeave:Connect(function()
						if not Library.IsOpen or isToggling then return end
						Tween(KeyStroke, 0.15, { Transparency = 0.35 })
						Tween(KeyBtn, 0.15, { BackgroundTransparency = Library:GetTheme().ElevatedTransparency })
					end)

					KeyBtn.MouseButton1Click:Connect(function()
						listening = true
						UpdateKeyDisplay("...", true)
					end)

					local kbConn = UserInputService.InputBegan:Connect(function(input, gpe)
						if listening and not gpe then
							if input.UserInputType == Enum.UserInputType.Keyboard then
								if input.KeyCode == Enum.KeyCode.Escape then
									key = Enum.KeyCode.Unknown
								else
									key = input.KeyCode
								end
								listening = false
								UpdateKeyDisplay(FormatKey(key), false)
								Library.Flags[flag] = key
								callback(key)
							elseif input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.MouseButton2 or input.UserInputType == Enum.UserInputType.MouseButton3 then
								key = input.UserInputType
								listening = false
								UpdateKeyDisplay(FormatKey(key), false)
								Library.Flags[flag] = key
								callback(key)
							end
						end
					end)
					GarbageCollector:AddConnection(kbConn)

					local function SetKey(newKey)
						if typeof(newKey) == "EnumItem" then
							key = newKey
						elseif type(newKey) == "string" and Enum.KeyCode[newKey] then
							key = Enum.KeyCode[newKey]
						end
						Library.Flags[flag] = key
						UpdateKeyDisplay(FormatKey(key), false)
						callback(key)
					end

					Library.ControlSetters[flag] = SetKey

					Library:OnThemeChange(function(th)
						Label.TextColor3 = th.Text
						KeyBtn.BackgroundColor3 = th.Elevated
						KeyLabel.TextColor3 = listening and th.Accent or th.TextDim
						KeyStroke.Color = th.DropStroke or Color3.fromRGB(48, 48, 54)
					end)

					table.insert(Library.SearchRegistry, {
						Name = name,
						Category = sectionName,
						Tab = TabObj,
						Subtab = SubtabObj,
						Element = KeybindRow
					})

					return {
						Set = SetKey,
						Get = function() return key end
					}
				end

