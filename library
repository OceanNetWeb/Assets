local _resolvedInfoBuffer = {
	Name = "",
	RawName = "",
	Icon = "",
	Qty = 1
}

local function ResolveItemInfo(itemInstance)
	if not itemInstance then return nil end

	local rawItem = nil
	local wrapper = nil

	if itemInstance:IsA("ObjectValue") then
		if not itemInstance.Value then
			return nil
		end
		rawItem = itemInstance.Value
		wrapper = itemInstance
	elseif itemInstance:IsA("GuiObject") or itemInstance:IsA("Frame") then
		local itemObjVal = itemInstance:FindFirstChild("Item")
		if itemObjVal and itemObjVal:IsA("ObjectValue") and itemObjVal.Value then
			return ResolveItemInfo(itemObjVal)
		end
		return nil
	elseif itemInstance:IsA("Model") or itemInstance:IsA("Tool") or itemInstance:IsA("Folder") then
		rawItem = itemInstance
		wrapper = itemInstance
	else
		return nil
	end

	if not rawItem then return nil end

	local itemName = rawItem.Name
	local props = rawItem:FindFirstChild("ItemProperties")
	local skinName = wrapper:GetAttribute("Skin") or (props and props:GetAttribute("Skin"))

	local cacheKey = itemName .. "|" .. tostring(skinName or "")
	if _itemIconCache[cacheKey] then
		local cached = _itemIconCache[cacheKey]
		local qty = wrapper:GetAttribute("Amount") or wrapper:GetAttribute("Count")
		if not qty and props then
			qty = props:GetAttribute("Amount") or props:GetAttribute("Count") or props:GetAttribute("Quantity")
		end
		if not qty and rawItem:GetAttribute("Amount") then
			qty = rawItem:GetAttribute("Amount")
		end
		local callSign = props and props:GetAttribute("CallSign")
		_resolvedInfoBuffer.Name = callSign or itemName
		_resolvedInfoBuffer.RawName = itemName
		_resolvedInfoBuffer.Icon = cached
		_resolvedInfoBuffer.Qty = qty or 1
		return _resolvedInfoBuffer
	end

	local icon = ""
	if props and props:FindFirstChild("ItemIcon") and props.ItemIcon:IsA("ImageLabel") and props.ItemIcon.Image ~= "" then
		icon = props.ItemIcon.Image
	elseif props and props:GetAttribute("ItemIcon") and props:GetAttribute("ItemIcon") ~= "" then
		icon = props:GetAttribute("ItemIcon")
	else
		icon = GetItemIcon(itemName, skinName)
	end

	_itemIconCache[cacheKey] = icon
	if icon ~= "" then
		PreloadIconAsync(icon)
	end

	local qty = wrapper:GetAttribute("Amount") or wrapper:GetAttribute("Count")
	if not qty and props then
		qty = props:GetAttribute("Amount") or props:GetAttribute("Count") or props:GetAttribute("Quantity")
	end
	if not qty and rawItem:GetAttribute("Amount") then
		qty = rawItem:GetAttribute("Amount")
	end

	local callSign = props and props:GetAttribute("CallSign")

	_resolvedInfoBuffer.Name = callSign or itemName
	_resolvedInfoBuffer.RawName = itemName
	_resolvedInfoBuffer.Icon = icon or ""
	_resolvedInfoBuffer.Qty = qty or 1
	return _resolvedInfoBuffer
end

local function renderSlot(slotFrame, itemInfo, hideQty)
	if not slotFrame then return end
	local iconLabel = slotFrame:FindFirstChild("ItemIcon")
	local qtyLabel = slotFrame:FindFirstChild("ItemQty")
	local nameLabel = slotFrame:FindFirstChild("ItemNameLabel")
	if not iconLabel or not qtyLabel then return end

	local isWanted = false
	if itemInfo and itemInfo.RawName and itemInfo.RawName ~= "" then
		local selectedList = Library.Flags and Library.Flags["ItemFinder_SelectedItems"]
		if type(selectedList) == "table" then
			for _, sel in ipairs(selectedList) do
				if sel == itemInfo.RawName then
					isWanted = true
					break
				end
			end
		end
		slotFrame:SetAttribute("_WantedRawName", itemInfo.RawName)
	else
		slotFrame:SetAttribute("_WantedRawName", "")
	end

	local slotStroke = slotFrame:FindFirstChildOfClass("UIStroke")
	if isWanted then
		slotFrame.BackgroundColor3 = Library:GetTheme().Accent
		slotFrame.BackgroundTransparency = 0.15
		if slotStroke then
			slotStroke.Color = Library:GetTheme().Accent
			slotStroke.Transparency = 0
			slotStroke.Thickness = 1.5
		end
	else
		slotFrame.BackgroundColor3 = Library:GetTheme().WindowBg
		slotFrame.BackgroundTransparency = Library:GetTheme().WindowTransparency
		if slotStroke then
			slotStroke.Color = Library:GetTheme().DropStroke or Color3.fromRGB(48, 48, 56)
			slotStroke.Transparency = 0.5
			slotStroke.Thickness = 1
		end
	end

	if itemInfo and itemInfo.Name and itemInfo.Name ~= "" then
		if itemInfo.Icon and itemInfo.Icon ~= "" then
			if iconLabel.Image ~= itemInfo.Icon then
				iconLabel.Image = itemInfo.Icon
			end
			if iconLabel.ImageTransparency ~= 0 then iconLabel.ImageTransparency = 0 end
			if nameLabel and nameLabel.Text ~= "" then nameLabel.Text = "" end
		else
			if iconLabel.Image ~= "" then iconLabel.Image = "" end
			if iconLabel.ImageTransparency ~= 1 then iconLabel.ImageTransparency = 1 end
			if nameLabel then
				local abbr = itemInfo.Name:sub(1, 6):upper()
				if nameLabel.Text ~= abbr then nameLabel.Text = abbr end
				if nameLabel.TextTransparency ~= 0 then nameLabel.TextTransparency = 0 end
			end
		end

		if not hideQty and itemInfo.Qty and tostring(itemInfo.Qty) ~= "1" and tostring(itemInfo.Qty) ~= "" then
			local qtyStr = tostring(itemInfo.Qty)
			if qtyLabel.Text ~= qtyStr then qtyLabel.Text = qtyStr end
			if qtyLabel.TextTransparency ~= 0 then qtyLabel.TextTransparency = 0 end
		else
			if qtyLabel.Text ~= "" then qtyLabel.Text = "" end
		end
	else
		if iconLabel.Image ~= "" then iconLabel.Image = "" end
		if iconLabel.ImageTransparency ~= 1 then iconLabel.ImageTransparency = 1 end
		if nameLabel and nameLabel.Text ~= "" then nameLabel.Text = "" end
		if qtyLabel.Text ~= "" then qtyLabel.Text = "" end
	end
end

