local _itemIconCache = {}
local _preloadedIds = {}
local ContentProvider = game:GetService("ContentProvider")

local function PreloadIconAsync(imageId)
	if not imageId or imageId == "" or _preloadedIds[imageId] then return end
	_preloadedIds[imageId] = true
	task.spawn(function()
		pcall(function()
			local dummy = Instance.new("ImageLabel")
			dummy.Image = imageId
			ContentProvider:PreloadAsync({ dummy })
			dummy:Destroy()
		end)
	end)
end

local RS_Skins = ReplicatedStorage:FindFirstChild("Skins")
local RS_ItemsList = ReplicatedStorage:FindFirstChild("ItemsList") or ReplicatedStorage:FindFirstChild("emsList")

local function GetItemIcon(itemName, skinName)
	if not itemName or itemName == "" then return "" end
	if not RS_Skins then
		RS_Skins = ReplicatedStorage:FindFirstChild("Skins")
	end
	if RS_Skins then
		local itemSkinFolder = RS_Skins:FindFirstChild(itemName) or (itemName:find("Pants") and RS_Skins:FindFirstChild("Pants")) or (itemName:find("Shirt") and RS_Skins:FindFirstChild("Shirt"))
		if itemSkinFolder then
			if skinName and skinName ~= "" and skinName ~= "Default" and itemSkinFolder:FindFirstChild(skinName) then
				local skinIcon = itemSkinFolder[skinName]:GetAttribute("ItemIcon")
				if skinIcon and skinIcon ~= "" then return skinIcon end
			end
			if itemSkinFolder:FindFirstChild("Default") and itemSkinFolder.Default:GetAttribute("ItemIcon") then
				local defIcon = itemSkinFolder.Default:GetAttribute("ItemIcon")
				if defIcon and defIcon ~= "" then return defIcon end
			end
		end
	end

	if not RS_ItemsList then
		RS_ItemsList = ReplicatedStorage:FindFirstChild("ItemsList") or ReplicatedStorage:FindFirstChild("emsList")
	end
	if RS_ItemsList and RS_ItemsList:FindFirstChild(itemName) then
		local tmpl = RS_ItemsList[itemName]
		local props = tmpl:FindFirstChild("ItemProperties")
		if props then
			if props:FindFirstChild("ItemIcon") and props.ItemIcon:IsA("ImageLabel") and props.ItemIcon.Image ~= "" then
				return props.ItemIcon.Image
			end
			local attrIcon = props:GetAttribute("ItemIcon") or props:GetAttribute("Icon") or props:GetAttribute("Image")
			if attrIcon and attrIcon ~= "" then return attrIcon end
		end
	end
	return ""
end

