local AcrylicSystem = {
	Folder = nil,
	DOF = nil,
	TrackedFrames = {},
	FocusDistance = 0.85,
	Enabled = true
}

function AcrylicSystem:SetEnabled(state)
	self.Enabled = (state == true)
	Library.Acrylic = self.Enabled
	if not self.Enabled then
		if self.DOF and self.DOF.Parent then
			self.DOF.Enabled = false
		end
		for _, data in pairs(self.TrackedFrames) do
			if data.GlassPart and data.GlassPart.Parent then
				data.GlassPart.Transparency = 1
			end
		end
	end
end

function AcrylicSystem:Init()
	if self.Folder then return end
	local camera = workspace.CurrentCamera
	if not camera then return end

	local folder = Instance.new("Folder")
	folder.Name = "Velocity_Acrylic_Folder"
	folder.Parent = camera
	self.Folder = folder
	GarbageCollector:AddInstance(folder)

	local dof = Lighting:FindFirstChild("Velocity_Acrylic_DoF") or Instance.new("DepthOfFieldEffect")
	dof.Name = "Velocity_Acrylic_DoF"
	dof.FarIntensity = 0
	dof.FocusDistance = self.FocusDistance
	dof.InFocusRadius = 0
	dof.NearIntensity = 1.0
	dof.Enabled = self.Enabled
	dof.Parent = Lighting
	self.DOF = dof
	GarbageCollector:AddInstance(dof)

	local math_rad = math.rad
	local math_tan = math.tan
	local math_max = math.max
	local Vector3_new = Vector3.new
	local CFrame_new = CFrame.new

	local renderConn = RunService.RenderStepped:Connect(function()
		local cam = workspace.CurrentCamera
		if not cam then return end

		if not Library.IsOpen or not AcrylicSystem.Enabled then
			if dof and dof.Parent then
				dof.Enabled = false
			end
			for _, data in pairs(AcrylicSystem.TrackedFrames) do
				if data.GlassPart and data.GlassPart.Parent then
					data.GlassPart.Transparency = 1
				end
			end
			return
		end

		local viewSize = cam.ViewportSize
		if viewSize.X <= 0 or viewSize.Y <= 0 then return end

		local anyVisible = false
		local inset = GuiService:GetGuiInset()
		local distance = 0.85
		local fov = math_rad(cam.FieldOfView)
		local viewHeight = 2 * distance * math_tan(fov * 0.5)
		local viewWidth = viewHeight * (viewSize.X / viewSize.Y)
		local camCF = cam.CFrame
		local winBg = Library:GetTheme().WindowBg

		for frame, data in pairs(AcrylicSystem.TrackedFrames) do
			local glassPart = data.GlassPart
			local isVisible = data.IsVisible and data.IsVisible()
			if isVisible == nil then
				isVisible = frame and frame.Parent and frame.Visible and frame.BackgroundTransparency < 0.99
			end

			if isVisible and glassPart and glassPart.Parent then
				anyVisible = true
				glassPart.Transparency = 0.98
				glassPart.Reflectance = 0
				glassPart.Color = winBg

				local framePos = frame.AbsolutePosition + inset
				local frameSize = frame.AbsoluteSize

				local scaleX = frameSize.X / viewSize.X
				local scaleY = frameSize.Y / viewSize.Y

				local offsetX = (framePos.X + (frameSize.X * 0.5) - (viewSize.X * 0.5)) / viewSize.X * viewWidth
				local offsetY = -(framePos.Y + (frameSize.Y * 0.5) - (viewSize.Y * 0.5)) / viewSize.Y * viewHeight

				glassPart.Size = Vector3_new(math_max(viewWidth * scaleX, 0.001), math_max(viewHeight * scaleY, 0.001), 0.001)
				glassPart.CFrame = camCF * CFrame_new(offsetX, offsetY, -distance)
			else
				if glassPart and glassPart.Parent then
					glassPart.Transparency = 1
				end
			end
		end

		if dof and dof.Parent then
			dof.Enabled = anyVisible
			dof.FocusDistance = AcrylicSystem.FocusDistance
		end
	end)
	GarbageCollector:AddConnection(renderConn)
end

function AcrylicSystem:AddFrame(frame, isVisibleFn)
	self:Init()
	if not self.Folder then return end

	local glassPart = Instance.new("Part")
	glassPart.Name = "AcrylicGlassPart_" .. (frame.Name or "Frame")
	glassPart.Material = Enum.Material.Glass
	glassPart.Transparency = self.Enabled and 0.98 or 1
	glassPart.Reflectance = 0
	glassPart.CastShadow = false
	glassPart.CanCollide = false
	glassPart.CanTouch = false
	glassPart.CanQuery = false
	glassPart.Anchored = true
	glassPart.Size = Vector3.new(1, 1, 0.001)
	glassPart.Color = Library:GetTheme().WindowBg
	glassPart.Parent = self.Folder
	GarbageCollector:AddInstance(glassPart)

	self.TrackedFrames[frame] = {
		GlassPart = glassPart,
		IsVisible = isVisibleFn
	}
end

function Library:SetAcrylic(state)
	AcrylicSystem:SetEnabled(state)
	local current = self:GetTheme()
	if self.MainFrame then
		self.MainFrame.BackgroundTransparency = current.WindowTransparency
		self.MainFrame:SetAttribute("OrigBgTrans", current.WindowTransparency)
	end
	for _, listener in ipairs(self.ThemeChangeListeners) do
		task.spawn(function()
			pcall(listener, current)
		end)
	end
end

local isSettingTheme = false
function Library:SetTheme(index)
	index = tonumber(index) or 1
	if isSettingTheme then return end
	if self.Themes[index] then
		isSettingTheme = true
		self.CurrentThemeIndex = index
		local current = self:GetTheme()
		for _, listener in ipairs(self.ThemeChangeListeners) do
			task.spawn(function()
				pcall(listener, current)
			end)
		end
		task.defer(function()
			isSettingTheme = false
		end)
	end
end

function Library:OnThemeChange(callback)
