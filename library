	function Library:SetKeybindsVisible(state, instant)
		if not self.KeybindsFrame or not self.KeybindsGui then return end
		if state then
			if self.KeybindsFrame.Visible and not instant and not self.IsLoadingConfig then return end
			self.KeybindsGui.Enabled = true
			self.KeybindsFrame.Visible = true
			if instant or self.IsLoadingConfig then
				KbScale.Scale = 1
				for _, descendant in ipairs(self.KeybindsFrame:GetDescendants()) do
					if descendant:IsA("Frame") and descendant.Name ~= "KbFrame" and descendant.Name ~= "List" then
						descendant.BackgroundTransparency = (descendant.Name == "CmdBadge" or descendant.Name == "Badge") and 0 or self:GetTheme().WindowTransparency
					elseif descendant:IsA("TextLabel") then
						descendant.TextTransparency = 0
					elseif descendant:IsA("UIStroke") then
						descendant.Transparency = 0.35
					end
				end
			else
				KbScale.Scale = 0.85
				Tween(KbScale, 0.22, { Scale = 1 }, Enum.EasingStyle.Back, Enum.EasingDirection.Out)
				for _, descendant in ipairs(self.KeybindsFrame:GetDescendants()) do
					if descendant:IsA("Frame") and descendant.Name ~= "KbFrame" and descendant.Name ~= "List" then
						Tween(descendant, 0.20, { BackgroundTransparency = (descendant.Name == "CmdBadge" or descendant.Name == "Badge") and 0 or self:GetTheme().WindowTransparency }, Enum.EasingStyle.Quart, Enum.EasingDirection.Out)
					elseif descendant:IsA("TextLabel") then
						Tween(descendant, 0.20, { TextTransparency = 0 }, Enum.EasingStyle.Quart, Enum.EasingDirection.Out)
					elseif descendant:IsA("UIStroke") then
						Tween(descendant, 0.20, { Transparency = 0.35 }, Enum.EasingStyle.Quart, Enum.EasingDirection.Out)
					end
				end
			end
		else
			if not self.KeybindsFrame.Visible then return end
			if instant or self.IsLoadingConfig then
				KbScale.Scale = 0.85
				if self.KeybindsGui then self.KeybindsGui.Enabled = false end
				self.KeybindsFrame.Visible = false
			else
				Tween(KbScale, 0.18, { Scale = 0.85 }, Enum.EasingStyle.Quart, Enum.EasingDirection.In)
				for _, descendant in ipairs(self.KeybindsFrame:GetDescendants()) do
					if descendant:IsA("Frame") and descendant.Name ~= "KbFrame" and descendant.Name ~= "List" then
						Tween(descendant, 0.18, { BackgroundTransparency = 1 }, Enum.EasingStyle.Quart, Enum.EasingDirection.In)
					elseif descendant:IsA("TextLabel") then
						Tween(descendant, 0.18, { TextTransparency = 1 }, Enum.EasingStyle.Quart, Enum.EasingDirection.In)
					elseif descendant:IsA("UIStroke") then
						Tween(descendant, 0.18, { Transparency = 1 }, Enum.EasingStyle.Quart, Enum.EasingDirection.In)
					end
				end
				task.delay(0.18, function()
					if not (Library.Flags["Menu_ShowKeybinds"] == true) then
						if self.KeybindsGui then self.KeybindsGui.Enabled = false end
					end
				end)
			end
		end
