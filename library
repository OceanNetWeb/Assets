							Tween(BtnStroke, 0.08, { Transparency = 1 })
							task.delay(0.1, function()
								if Library.IsOpen and Btn and Btn.Parent then
									Tween(Btn, 0.15, { BackgroundColor3 = Library:GetTheme().Elevated, TextColor3 = Library:GetTheme().Text })
									Tween(BtnStroke, 0.15, { Transparency = 0.35 })
