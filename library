			pcall(callback)
		end)
	end
end

local function MakeDraggable(dragBar, targetFrame)
	local dragging = false
	local dragInput, dragStart, startPos

	local c1 = dragBar.InputBegan:Connect(function(input)
		if (input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch) then
			if not Library.IsOpen and targetFrame ~= Library.MainFrame then
				return
			end
			dragging = true
			dragStart = input.Position
			startPos = targetFrame.Position

			input.Changed:Connect(function()
				if input.UserInputState == Enum.UserInputState.End then
					dragging = false
				end
			end)
		end
	end)
	GarbageCollector:AddConnection(c1)

	local c2 = dragBar.InputChanged:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch then
			dragInput = input
		end
	end)
	GarbageCollector:AddConnection(c2)

	local c3 = UserInputService.InputChanged:Connect(function(input)
		if input == dragInput and dragging then
			local delta = input.Position - dragStart
			targetFrame.Position = UDim2.new(
				startPos.X.Scale,
				startPos.X.Offset + delta.X,
				startPos.Y.Scale,
				startPos.Y.Offset + delta.Y
			)
		end
	end)
	GarbageCollector:AddConnection(c3)
end

