local math_floor = math.floor
local Color3_fromHSV = Color3.fromHSV

local animLoopConn = RunService.Heartbeat:Connect(function()
	if not next(Library.AnimatedColors) then return end
	local t = tick()
	for _, colData in pairs(Library.AnimatedColors) do
		local mode = colData.Mode
		local spd = colData.Speed or 1
		local seed = colData.Seed or 0
		if mode == "RGB" then
			local h = (t * spd * 0.2 + seed * 0.1) % 1
			colData.Hue = h
			local c = Color3_fromHSV(h, colData.Sat or 1, colData.Val or 1)
			colData.Color = c
			local box = colData.Box
			if box and box.Parent then box.BackgroundColor3 = c end
			local cb = colData.Callback
			if cb then cb(c, colData.Alpha or 1, colData) end
		elseif mode == "Seq" then
			local stops = colData.Stops
			if stops and #stops >= 2 then
				local numStops = #stops
				local progress = ((t * spd * 0.2 + seed * 0.1) % 1) * (numStops - 1)
				local idx = math_floor(progress) + 1
				local alpha = progress - math_floor(progress)
				local nextIdx = (idx >= numStops) and 1 or (idx + 1)
				local c1 = stops[idx] or Color3.new(1, 1, 1)
				local c2 = stops[nextIdx] or Color3.new(1, 1, 1)
				local c = c1:Lerp(c2, alpha)
				colData.Color = c
				local box = colData.Box
				if box and box.Parent then box.BackgroundColor3 = c end
				local cb = colData.Callback
				if cb then cb(c, colData.Alpha or 1, colData) end
			end
		end
	end
end)
