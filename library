	HeaderPad.PaddingRight = UDim.new(0, 6)
	HeaderPad.PaddingTop = UDim.new(0, 1)
	HeaderPad.PaddingBottom = UDim.new(0, 1)
	HeaderPad.Parent = HeaderBadge

	local BpHeader = Instance.new("TextLabel")
	BpHeader.Name = "Header"
	BpHeader.Size = UDim2.fromOffset(0, 16)
	BpHeader.AutomaticSize = Enum.AutomaticSize.X
	BpHeader.BackgroundTransparency = 1
	ApplyFont(BpHeader, "Bold")
	BpHeader.Text = "BACKPACK"
	BpHeader.TextSize = 9
	BpHeader.TextColor3 = self:GetTheme().Dark or Color3.fromRGB(17, 17, 17)
	BpHeader.TextYAlignment = Enum.TextYAlignment.Center
	BpHeader.Parent = HeaderBadge

	-- Grid Container for 6 slots per row (Width = 6 * 44 + 5 * 3 = 279px)
	local GridContainer = Instance.new("Frame")
	GridContainer.Name = "GridContainer"
	GridContainer.LayoutOrder = 2
	GridContainer.Size = UDim2.fromOffset(279, 0)
	GridContainer.AutomaticSize = Enum.AutomaticSize.Y
	GridContainer.BackgroundTransparency = 1
	GridContainer.Parent = TargetBpFrame

	local GridLayout = Instance.new("UIGridLayout")
	GridLayout.CellSize = UDim2.fromOffset(44, 44)
	GridLayout.CellPadding = UDim2.fromOffset(3, 3)
	GridLayout.FillDirection = Enum.FillDirection.Horizontal
	GridLayout.SortOrder = Enum.SortOrder.LayoutOrder
	GridLayout.Parent = GridContainer

	local createdBpSlots = {}

	local function createBpSlot(index)
		local slot = Instance.new("Frame")
		slot.Name = "Slot_" .. tostring(index)
		slot.LayoutOrder = index
		slot.Size = UDim2.fromOffset(44, 44)
		slot.BackgroundColor3 = self:GetTheme().WindowBg
		slot.BackgroundTransparency = self:GetTheme().WindowTransparency
		slot.BorderSizePixel = 0
		slot.Active = true
		slot.Parent = GridContainer

		local slotAspect = Instance.new("UIAspectRatioConstraint")
		slotAspect.AspectRatio = 1
		slotAspect.Parent = slot

		local slotCorner = Instance.new("UICorner")
		slotCorner.CornerRadius = UDim.new(0, 6)
		slotCorner.Parent = slot

		local slotStroke = Instance.new("UIStroke")
		slotStroke.Color = self:GetTheme().DropStroke or Color3.fromRGB(48, 48, 56)
		slotStroke.Transparency = 0.5
		slotStroke.Thickness = 1
		slotStroke.Parent = slot

		local itemIcon = Instance.new("ImageLabel")
		itemIcon.Name = "ItemIcon"
		itemIcon.AnchorPoint = Vector2.new(0.5, 0.5)
		itemIcon.Position = UDim2.fromScale(0.5, 0.5)
		itemIcon.Size = UDim2.new(1, -6, 1, -6)
		itemIcon.BackgroundTransparency = 1
		itemIcon.ImageTransparency = 1
		itemIcon.ScaleType = Enum.ScaleType.Fit
		itemIcon.Parent = slot

		local nameLabel = Instance.new("TextLabel")
		nameLabel.Name = "ItemNameLabel"
		nameLabel.AnchorPoint = Vector2.new(0.5, 0.5)
		nameLabel.Position = UDim2.fromScale(0.5, 0.5)
		nameLabel.Size = UDim2.new(1, -4, 1, -4)
		nameLabel.BackgroundTransparency = 1
		ApplyFont(nameLabel, "Bold")
		nameLabel.Text = ""
		nameLabel.TextSize = 10
		nameLabel.TextColor3 = self:GetTheme().Text
		nameLabel.TextScaled = true
		nameLabel.Parent = slot

		local itemQty = Instance.new("TextLabel")
		itemQty.Name = "ItemQty"
		itemQty.AnchorPoint = Vector2.new(1, 1)
		itemQty.Position = UDim2.new(1, -3, 1, -2)
		itemQty.Size = UDim2.fromOffset(22, 11)
		itemQty.BackgroundTransparency = 1
		ApplyFont(itemQty, "Bold")
		itemQty.Text = ""
		itemQty.TextSize = 9
		itemQty.TextColor3 = self:GetTheme().Text
		itemQty.TextXAlignment = Enum.TextXAlignment.Right
		itemQty.Parent = slot

		return slot
	end

	for i = 1, 36 do
		table.insert(createdBpSlots, createBpSlot(i))
	end

	local isHidingTargetBp = false
	local hideBpAnimToken = 0

	local lastBpUpdateTarget = nil
	local lastBpUpdateTime = 0

	function Library:UpdateTargetBackpack(targetObj)
		if not self.TargetBackpackFrame or not self.TargetBackpackGui or not self.TargetBackpackGui.Enabled then return end

		local targetPlayer = nil
		if targetObj then
			if targetObj:IsA("Player") and targetObj.Parent == Players then
				targetPlayer = targetObj
			elseif targetObj:IsA("Model") then
				targetPlayer = Players:GetPlayerFromCharacter(targetObj)
				if not targetPlayer then
					local found = Players:FindFirstChild(targetObj.Name)
					if found and found:IsA("Player") then
						targetPlayer = found
					end
				end
			end
		end

		if not targetPlayer and Library.IsOpen then
			targetPlayer = LocalPlayer
		end

		local now = tick()
		if targetPlayer and targetPlayer == lastBpUpdateTarget and (now - lastBpUpdateTime) < 0.15 then
			return
		end
		lastBpUpdateTarget = targetPlayer
		lastBpUpdateTime = now

		local classifiedBp = {}
		local maxBpSlot = 0

		local rsPlayers = ReplicatedStorage:FindFirstChild("Players")
		local rsPlayer = (targetPlayer and rsPlayers) and rsPlayers:FindFirstChild(targetPlayer.Name)
		local inv = rsPlayer and rsPlayer:FindFirstChild("Inventory")

		if inv then
			local bpItem = nil
			local bpInv = nil

			-- 1. Check known slot names on inventory
			for _, slotName in ipairs({ "ClothingBackpack", "Backpack", "Bag", "ClothingBag", "ItemBackpack" }) do
				local c = inv:FindFirstChild(slotName)
				if c then
					bpItem = c
					break
				end
			end

			-- 2. Fallback: Search all items for backpack attribute / category / child inventory
			if not bpItem then
				for _, c in ipairs(inv:GetChildren()) do
					local s = tostring(c:GetAttribute("Slot") or c.Name):lower()
					if s:find("backpack") or s:find("bag") then
						bpItem = c
						break
					end
				end
			end

			if not bpItem then
				for _, c in ipairs(inv:GetChildren()) do
					if c:IsA("ObjectValue") and c.Value then
						local valName = c.Value.Name:lower()
						if (valName:find("backpack") or valName:find("bag") or valName:find("pack") or valName:find("duffle") or valName:find("satchel")) and c.Value:FindFirstChild("Inventory") then
							bpItem = c
							break
						end
					end
				end
			end

			if bpItem then
				if bpItem:FindFirstChild("Inventory") then
					bpInv = bpItem.Inventory
				elseif bpItem:IsA("ObjectValue") and bpItem.Value and bpItem.Value:FindFirstChild("Inventory") then
					bpInv = bpItem.Value.Inventory
				end
			end

			-- 3. If found backpack container, get slots
			if bpInv then
				local slotsAttr = bpInv:GetAttribute("Slots") or bpInv:GetAttribute("Size") or bpInv:GetAttribute("Capacity") or (bpItem and (bpItem:GetAttribute("Slots") or bpItem:GetAttribute("Capacity") or (bpItem:IsA("ObjectValue") and bpItem.Value and bpItem.Value:GetAttribute("Slots"))))
				if tonumber(slotsAttr) and tonumber(slotsAttr) > 0 then
					maxBpSlot = tonumber(slotsAttr)
				end

				for _, child in ipairs(bpInv:GetChildren()) do
					local slotAttr = child:GetAttribute("Slot") or child.Name
					local num = _slotNumberLookup[slotAttr] or tonumber(slotAttr) or tonumber((tostring(slotAttr):match("%d+")))
					if num and num >= 1 and num <= 36 then
						if child:IsA("ObjectValue") and child.Value then
							classifiedBp[num] = child
						end
						if num > maxBpSlot then
							maxBpSlot = num
						end
					end
				end
			end
		end

		local displaySlotsCount = math.clamp(maxBpSlot > 0 and maxBpSlot or 18, 6, 36)
		local remainder = displaySlotsCount % 6
		if remainder ~= 0 then
			displaySlotsCount = displaySlotsCount + (6 - remainder)
		end

		for i = 1, 36 do
			local slot = createdBpSlots[i]
			if slot then
				if i <= displaySlotsCount then
					slot.Visible = true
					local itemInfo = ResolveItemInfo(classifiedBp[i])
					renderSlot(slot, itemInfo)
				else
					slot.Visible = false
					renderSlot(slot, nil)
				end
			end
		end
	end

	function Library:SetTargetBackpackVisible(state)
		if not self.TargetBackpackFrame or not self.TargetBackpackGui then return end

		hideBpAnimToken = hideBpAnimToken + 1
		local currentToken = hideBpAnimToken

		if state then
			isHidingTargetBp = false
			self.TargetBackpackGui.Enabled = true
			self.TargetBackpackFrame.Visible = true

			Tween(BpHudScale, 0.15, { Scale = 1 }, Enum.EasingStyle.Quart, Enum.EasingDirection.Out)
			Tween(HeaderBadge, 0.15, { BackgroundTransparency = 0 }, Enum.EasingStyle.Quart, Enum.EasingDirection.Out)
			Tween(BpHeader, 0.15, { TextTransparency = 0 }, Enum.EasingStyle.Quart, Enum.EasingDirection.Out)

			for _, slot in ipairs(createdBpSlots) do
				Tween(slot, 0.15, { BackgroundTransparency = self:GetTheme().WindowTransparency }, Enum.EasingStyle.Quart, Enum.EasingDirection.Out)
				local stroke = slot:FindFirstChildOfClass("UIStroke")
				if stroke then
					Tween(stroke, 0.15, { Transparency = 0.5 }, Enum.EasingStyle.Quart, Enum.EasingDirection.Out)
				end
			end
		else
			isHidingTargetBp = true
			Tween(BpHudScale, 0.15, { Scale = 0.85 }, Enum.EasingStyle.Quart, Enum.EasingDirection.In)
			Tween(HeaderBadge, 0.15, { BackgroundTransparency = 1 }, Enum.EasingStyle.Quart, Enum.EasingDirection.In)
			Tween(BpHeader, 0.15, { TextTransparency = 1 }, Enum.EasingStyle.Quart, Enum.EasingDirection.In)

			for _, slot in ipairs(createdBpSlots) do
				Tween(slot, 0.15, { BackgroundTransparency = 1 }, Enum.EasingStyle.Quart, Enum.EasingDirection.In)
				local stroke = slot:FindFirstChildOfClass("UIStroke")
				if stroke then
					Tween(stroke, 0.15, { Transparency = 1 }, Enum.EasingStyle.Quart, Enum.EasingDirection.In)
				end
			end

			task.delay(0.15, function()
				if hideBpAnimToken == currentToken then
					local shouldStay = (self.TargetBackpackEnabled ~= false) and (self.TargetInventoryEnabled ~= false) and (Library.IsOpen or _G.SilentAimTargetObject ~= nil)
					if not shouldStay then
						if self.TargetBackpackFrame then self.TargetBackpackFrame.Visible = false end
						if self.TargetBackpackGui then self.TargetBackpackGui.Enabled = false end
					end
					isHidingTargetBp = false
				end
			end)
		end
	end

	MakeDraggable(TargetBpFrame, TargetBpFrame)

	Library:OnThemeChange(function(th)
		HeaderBadge.BackgroundColor3 = th.Accent
		BpHeader.TextColor3 = th.Dark or Color3.fromRGB(17, 17, 17)
		for _, slot in ipairs(createdBpSlots) do
			slot.BackgroundColor3 = th.WindowBg
			slot.BackgroundTransparency = th.WindowTransparency
			local stroke = slot:FindFirstChildOfClass("UIStroke")
			if stroke then
				stroke.Color = th.DropStroke or Color3.fromRGB(48, 48, 56)
			end
		end
	end)

	return TargetBpFrame
end

--------------------------------------------------------------------------------
-- FLOATING NOTIFICATIONS / HIT LOGS ENGINE (PILL TOASTS WITH ACCENT BADGE)
--------------------------------------------------------------------------------

local NotificationHolder = nil
local notificationCounter = 0

function Library:InitNotificationHolder()
	local valid = false
	pcall(function()
		if NotificationHolder and NotificationHolder.Parent then
			valid = true
		end
	end)
	if valid then return NotificationHolder end

	pcall(function()
		local safeParent = GetSafeGuiParent()
		local ScreenGui = Instance.new("ScreenGui")
		ScreenGui.Name = "Velocity_Notifications"
		ScreenGui.ResetOnSpawn = false
		ScreenGui.DisplayOrder = 10005
		ScreenGui.Parent = safeParent
		self.NotificationGui = ScreenGui
		GarbageCollector:AddInstance(ScreenGui)

		local Holder = Instance.new("Frame")
		Holder.Name = "NotificationHolder"
		Holder.AnchorPoint = Vector2.new(0, 0)
		Holder.Position = UDim2.new(0, 10, 0, 16)
		Holder.Size = UDim2.fromOffset(0, 0)
		Holder.AutomaticSize = Enum.AutomaticSize.XY
		Holder.BackgroundTransparency = 1
		Holder.Parent = ScreenGui
		NotificationHolder = Holder

		local ListLayout = Instance.new("UIListLayout")
		ListLayout.Name = "ListLayout"
		ListLayout.SortOrder = Enum.SortOrder.LayoutOrder
		ListLayout.FillDirection = Enum.FillDirection.Vertical
		ListLayout.HorizontalAlignment = Enum.HorizontalAlignment.Left
		ListLayout.Padding = UDim.new(0, 4)
		ListLayout.Parent = Holder
	end)

	return NotificationHolder
end

function Library:Notify(config, duration)
	local resultToast = nil
	pcall(function()
		local text = ""
		local icon = nil
		local dur = 3.5

		if type(config) == "string" then
			text = config
			dur = duration or 3.5
		elseif type(config) == "table" then
			text = config.Text or config.Content or config.Title or "Notification"
			icon = config.Icon
			dur = config.Duration or duration or 3.5
		end

		local holder = self:InitNotificationHolder()
		if not holder then return end

		notificationCounter = notificationCounter + 1
		local th = self:GetTheme()

		local ToastPill = Instance.new("Frame")
		ToastPill.Name = "Toast"
		ToastPill.LayoutOrder = notificationCounter
		ToastPill.Size = UDim2.fromOffset(0, 22)
		ToastPill.AutomaticSize = Enum.AutomaticSize.X
		ToastPill.BackgroundColor3 = th.WindowBg
		ToastPill.BackgroundTransparency = 1
		ToastPill.Parent = holder

		local ToastCorner = Instance.new("UICorner")
		ToastCorner.CornerRadius = UDim.new(0, 5)
		ToastCorner.Parent = ToastPill

		local ToastStroke = Instance.new("UIStroke")
		ToastStroke.Color = th.DropStroke or Color3.fromRGB(48, 48, 56)
		ToastStroke.Transparency = 1
		ToastStroke.Thickness = 1
		ToastStroke.ApplyStrokeMode = Enum.ApplyStrokeMode.Border
		ToastStroke.Parent = ToastPill

		local ToastPad = Instance.new("UIPadding")
		ToastPad.PaddingTop = UDim.new(0, 2)
		ToastPad.PaddingBottom = UDim.new(0, 2)
		ToastPad.PaddingLeft = UDim.new(0, 3)
		ToastPad.PaddingRight = UDim.new(0, 8)
		ToastPad.Parent = ToastPill

		local ToastLayout = Instance.new("UIListLayout")
		ToastLayout.FillDirection = Enum.FillDirection.Horizontal
		ToastLayout.VerticalAlignment = Enum.VerticalAlignment.Center
		ToastLayout.SortOrder = Enum.SortOrder.LayoutOrder
		ToastLayout.Padding = UDim.new(0, 6)
		ToastLayout.Parent = ToastPill

		-- Left Icon Badge (e.g. Target / Crosshair / Eye)
		local ToastBadge = Instance.new("Frame")
		ToastBadge.Name = "ToastBadge"
		ToastBadge.LayoutOrder = 1
		ToastBadge.Size = UDim2.fromOffset(16, 16)
		ToastBadge.BackgroundColor3 = th.Accent
		ToastBadge.BackgroundTransparency = 1
		ToastBadge.Parent = ToastPill

		local BadgeCorner = Instance.new("UICorner")
		BadgeCorner.CornerRadius = UDim.new(0, 4)
		BadgeCorner.Parent = ToastBadge

		local BadgeIcon = Instance.new("ImageLabel")
		BadgeIcon.Name = "BadgeIcon"
		BadgeIcon.AnchorPoint = Vector2.new(0.5, 0.5)
		BadgeIcon.Position = UDim2.fromScale(0.5, 0.5)
		BadgeIcon.Size = UDim2.fromOffset(11, 11)
		BadgeIcon.ScaleType = Enum.ScaleType.Fit
		BadgeIcon.BackgroundTransparency = 1
		BadgeIcon.Image = icon or "rbxassetid://6031075931" -- Target / Crosshair / Bullseye
		BadgeIcon.ImageColor3 = th.Dark or Color3.fromRGB(17, 17, 17)
		BadgeIcon.ImageTransparency = 1
		BadgeIcon.Parent = ToastBadge

		-- Formatted Text Label
		local Label = Instance.new("TextLabel")
		Label.Name = "Label"
		Label.LayoutOrder = 2
		Label.Size = UDim2.fromOffset(0, 18)
		Label.AutomaticSize = Enum.AutomaticSize.X
		Label.BackgroundTransparency = 1
		Label.RichText = true
		ApplyFont(Label, "Medium")

		-- Auto-format highlight for numbers and bracketed entities if text does not contain custom font tags
		local formattedText = text
		if not text:find("<font") and not text:find("<b>") then
			-- Highlight [tag]
			formattedText = formattedText:gsub("(%b[])", "<b><font color=\"#ffffff\">%1</font></b>")
			-- Highlight numbers
			formattedText = formattedText:gsub("(%d+)", "<b><font color=\"#ffffff\">%1</font></b>")
			-- Highlight common body parts
			for _, part in ipairs({ "head", "chest", "torso", "stomach", "left arm", "right arm", "left leg", "right leg" }) do
				formattedText = formattedText:gsub("%f[%a]" .. part .. "%f[%A]", "<b><font color=\"#ffffff\">" .. part .. "</font></b>")
			end
		end

		Label.Text = formattedText
		Label.TextColor3 = th.TextDim
		Label.TextSize = 11
		Label.TextTransparency = 1
		Label.TextYAlignment = Enum.TextYAlignment.Center
		Label.Parent = ToastPill

		local ToastScale = Instance.new("UIScale")
		ToastScale.Scale = 0.85
		ToastScale.Parent = ToastPill

		ToastPill.Position = UDim2.fromOffset(-50, 0)

		-- Entrance Slide-In from Left & Scale Animation
		Tween(ToastPill, 0.25, { Position = UDim2.fromOffset(0, 0), BackgroundTransparency = th.WindowTransparency }, Enum.EasingStyle.Quart, Enum.EasingDirection.Out)
		Tween(ToastScale, 0.25, { Scale = 1 }, Enum.EasingStyle.Back, Enum.EasingDirection.Out)
		Tween(ToastStroke, 0.22, { Transparency = 0.35 }, Enum.EasingStyle.Quart, Enum.EasingDirection.Out)
		Tween(ToastBadge, 0.22, { BackgroundTransparency = 0 }, Enum.EasingStyle.Quart, Enum.EasingDirection.Out)
		Tween(BadgeIcon, 0.22, { ImageTransparency = 0 }, Enum.EasingStyle.Quart, Enum.EasingDirection.Out)
		Tween(Label, 0.22, { TextTransparency = 0 }, Enum.EasingStyle.Quart, Enum.EasingDirection.Out)

		-- Exit Slide-Out to Left & Fade after duration
		task.delay(dur, function()
			if ToastPill and ToastPill.Parent then
				Tween(ToastPill, 0.20, { Position = UDim2.fromOffset(-50, 0), BackgroundTransparency = 1 }, Enum.EasingStyle.Quart, Enum.EasingDirection.In)
				Tween(ToastScale, 0.20, { Scale = 0.85 }, Enum.EasingStyle.Quart, Enum.EasingDirection.In)
				Tween(ToastStroke, 0.20, { Transparency = 1 }, Enum.EasingStyle.Quart, Enum.EasingDirection.In)
				Tween(ToastBadge, 0.20, { BackgroundTransparency = 1 }, Enum.EasingStyle.Quart, Enum.EasingDirection.In)
				Tween(BadgeIcon, 0.20, { ImageTransparency = 1 }, Enum.EasingStyle.Quart, Enum.EasingDirection.In)
				Tween(Label, 0.20, { TextTransparency = 1 }, Enum.EasingStyle.Quart, Enum.EasingDirection.In)
				task.delay(0.20, function()
					if ToastPill and ToastPill.Parent then
						ToastPill:Destroy()
					end
				end)
			end
		end)

		resultToast = ToastPill
	end)

	return resultToast
end
