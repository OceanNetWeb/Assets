	function Window:Toggle()
		if isToggling then return end
		Library.IsOpen = not Library.IsOpen

		if Library.IsOpen then
			isToggling = true
			ScreenGui.Enabled = true
			MainFrame.Visible = true
			SetCursorState(true)
			local curXScale = MainFrame.Position.X.Scale
			local curXOffset = MainFrame.Position.X.Offset
			local startOpenPos = UDim2.new(curXScale, curXOffset, 0.5, -windowSize.Y.Offset / 2 + 22)
			MainFrame.Position = startOpenPos
			MainFrame.GroupTransparency = 1

			Tween(MainFrame, 0.24, { Position = savedCenterPos, GroupTransparency = 0 }, Enum.EasingStyle.Quart, Enum.EasingDirection.Out)

			local isSettingsActive = Window and Window.ActiveTab and Window.ActiveTab.IsHidden
			SettingsBtn.BackgroundColor3 = isSettingsActive and Library:GetTheme().Accent or Library:GetTheme().Elevated
			SettingsBtn.BackgroundTransparency = isSettingsActive and 0 or 1
			SettingsIcon.ImageColor3 = isSettingsActive and Library:GetTheme().Dark or Library:GetTheme().TextDim

			if Window.ActiveTab then
				if Window.ActiveTab.IsHidden then
					TabPill.BackgroundTransparency = 1
					for _, t in ipairs(Window.Tabs) do
						if t.Icon then t.Icon.ImageColor3 = Library:GetTheme().TextDim end
					end
				else
					local targetPillPos
					if Window.ActiveTab.IsBottom then
						targetPillPos = UDim2.new(0, 5, 1, -31 - ((Window.ActiveTab.BottomOffset or 1) - 1) * 31)
					else
						local idx = Window.ActiveTab.TopIndex or 1
						targetPillPos = UDim2.fromOffset(5, 5 + (idx - 1) * 31)
					end
					TabPill.Position = targetPillPos
					TabPill.BackgroundColor3 = Library:GetTheme().Accent
					TabPill.BackgroundTransparency = 0
					for _, t in ipairs(Window.Tabs) do
						if t.Icon then
							t.Icon.ImageColor3 = (t == Window.ActiveTab) and Library:GetTheme().Dark or Library:GetTheme().TextDim
						end
					end
				end
				if Window.ActiveTab.ActiveSubtab then
					Window.ActiveTab.ActiveSubtab:Select(true)
				elseif #Window.ActiveTab.Subtabs > 0 then
					Window.ActiveTab.Subtabs[1]:Select(true)
				end
			end

			task.delay(0.24, function()
				isToggling = false
			end)
		else
			isToggling = true
			CloseAllPopups()
			SetCursorState(false)
			local curXScale = MainFrame.Position.X.Scale
			local curXOffset = MainFrame.Position.X.Offset
			local closeTargetPos = UDim2.new(curXScale, curXOffset, 0.5, -windowSize.Y.Offset / 2 + 18)

			local isSettingsActive = Window and Window.ActiveTab and Window.ActiveTab.IsHidden
			SettingsBtn.BackgroundColor3 = isSettingsActive and Library:GetTheme().Accent or Library:GetTheme().Elevated
			SettingsBtn.BackgroundTransparency = isSettingsActive and 0 or 1
			SettingsIcon.ImageColor3 = isSettingsActive and Library:GetTheme().Dark or Library:GetTheme().TextDim

			Tween(MainFrame, 0.18, { Position = closeTargetPos, GroupTransparency = 1 }, Enum.EasingStyle.Quart, Enum.EasingDirection.In)

			task.delay(0.18, function()
				if not Library.IsOpen then
					MainFrame.Visible = false
					ScreenGui.Enabled = false
					MainFrame.Position = savedCenterPos
					SetCursorState(false)
				end
				isToggling = false
			end)
		end
	end

