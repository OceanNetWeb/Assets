				local SectionCard = Instance.new("Frame")
				SectionCard.Name = "Section_" .. sectionName
				SectionCard.Size, SectionCard.AutomaticSize = UDim2.new(1, -4, 0, 0), Enum.AutomaticSize.Y
				SectionCard.BackgroundColor3, SectionCard.BackgroundTransparency = currentTheme.Card, currentTheme.CardTransparency
				SectionCard.Parent = parentCol

				local SectionCorner = Instance.new("UICorner")
				SectionCorner.CornerRadius = UDim.new(0, 8); SectionCorner.Parent = SectionCard

				local SectionPadding = Instance.new("UIPadding")
				SectionPadding.PaddingTop, SectionPadding.PaddingBottom = UDim.new(0, 8), UDim.new(0, 8)
				SectionPadding.PaddingLeft, SectionPadding.PaddingRight = UDim.new(0, 10), UDim.new(0, 10)
				SectionPadding.Parent = SectionCard

				local SectionLayout = Instance.new("UIListLayout")
				SectionLayout.SortOrder, SectionLayout.Padding = Enum.SortOrder.LayoutOrder, UDim.new(0, 8)
				SectionLayout.Parent = SectionCard

				Library:OnThemeChange(function(th)
					SectionCard.BackgroundColor3, SectionCard.BackgroundTransparency = th.Card, th.CardTransparency
				end)

				local SectionObj = {
					Container = SectionCard
				}

				local function checkDependsActive(dep)
					if not dep then return true end
					if type(dep) == "table" then
						if dep.Any == true or dep.Mode == "OR" then
							local hasOne = false
							for _, f in ipairs(dep) do
								if type(f) == "string" and Library.Flags[f] == true then
									hasOne = true
									break
								end
							end
							return hasOne
						else
							for _, f in ipairs(dep) do
								if type(f) == "string" and Library.Flags[f] ~= true then return false end
							end
							return true
						end
					end
					return Library.Flags[dep] == true
				end

				local function hookDepends(dep, card, origH)
					if not dep then return end
					local flagsToWatch = {}
					if type(dep) == "table" then
						for _, f in ipairs(dep) do
							if type(f) == "string" then table.insert(flagsToWatch, f) end
						end
					elseif type(dep) == "string" then
						table.insert(flagsToWatch, dep)
					end
					local currentActive = checkDependsActive(dep)
					card.Visible = currentActive
					card.Size = currentActive and UDim2.new(1, 0, 0, origH) or UDim2.new(1, 0, 0, 0)
					card.ClipsDescendants = false

					local animId = 0
					for _, f in ipairs(flagsToWatch) do
						Library:OnToggleChange(f, function()
							local shouldBeActive = checkDependsActive(dep)
							if shouldBeActive == currentActive then return end
							currentActive = shouldBeActive
							animId = animId + 1
							local thisAnim = animId

							if shouldBeActive then
								card.ClipsDescendants = false
								card.Visible = true
								Tween(card, 0.22, { Size = UDim2.new(1, 0, 0, origH) }, Enum.EasingStyle.Quart, Enum.EasingDirection.Out)
							else
								card.ClipsDescendants = false
								local tw = Tween(card, 0.18, { Size = UDim2.new(1, 0, 0, 0) }, Enum.EasingStyle.Quart, Enum.EasingDirection.In)
								tw.Completed:Connect(function()
									if thisAnim == animId and not currentActive then
										card.Visible = false
									end
								end)
							end
						end)
					end
				end

