		local count = 0
		if type(selectedList) == "table" then
			for _, item in ipairs(selectedList) do
				currentElements[item] = true
				count = count + 1
			end
		end
		local showUser = (currentElements["User"] == true)
		local showPing = (currentElements["Ping"] == true)
		local showFps = (currentElements["FPS"] == true)
		local showTime = (currentElements["Time"] == true)

		if UserText then
			UserText.Visible = showUser
			UserText.TextTransparency = 0
		end
		if div1 then
			div1.Visible = showUser and (showPing or showFps or showTime)
			div1.BackgroundTransparency = 0.4
		end
		if PingContainer then
			PingContainer.Visible = showPing
			PingVal.TextTransparency = 0
			PingUnit.TextTransparency = 0
		end
		if div2 then
			div2.Visible = showPing and (showFps or showTime)
			div2.BackgroundTransparency = 0.4
		end
		if FpsContainer then
			FpsContainer.Visible = showFps
			FpsVal.TextTransparency = 0
			FpsUnit.TextTransparency = 0
		end
		if div3 then
			div3.Visible = showFps and showTime
			div3.BackgroundTransparency = 0.4
		end
		if TimeText then
			TimeText.Visible = showTime
			TimeText.TextTransparency = 0
		end

		-- Auto-hide watermark if nothing is selected
		if count == 0 then
			self:SetWatermarkVisible(false)
		else
			if self.Flags["Menu_ShowWatermark"] ~= false then
				self:SetWatermarkVisible(true)
			end
		end
	end

	-- Previous Clean Scale & Fade Watermark Animation
	function Library:SetWatermarkVisible(state, instant)
		if not self.WatermarkFrame or not self.WatermarkGui then return end
		local th = self:GetTheme()
		if state then
			if self.WatermarkFrame.Visible and not instant and not self.IsLoadingConfig then return end
			self.WatermarkGui.Enabled = true
			self.WatermarkFrame.Visible = true
			if instant or self.IsLoadingConfig then
				WmScale.Scale = 1
				self.WatermarkFrame.BackgroundTransparency = th.WindowTransparency
				Stroke.Transparency = 0.35
				BrandBadge.BackgroundTransparency = 0
				BrandText.TextTransparency = 0
				LogoIcon.ImageTransparency = 0
				for _, descendant in ipairs(self.WatermarkFrame:GetDescendants()) do
					if descendant:IsA("TextLabel") then
						descendant.TextTransparency = 0
					elseif descendant:IsA("Frame") and descendant ~= self.WatermarkFrame and descendant ~= BrandBadge and not descendant.Name:find("Container") and not descendant.Name:find("Wrapper") then
						descendant.BackgroundTransparency = 0.4
					end
				end
			else
				WmScale.Scale = 0.85
				Tween(WmScale, 0.22, { Scale = 1 }, Enum.EasingStyle.Back, Enum.EasingDirection.Out)
				Tween(self.WatermarkFrame, 0.22, { BackgroundTransparency = th.WindowTransparency }, Enum.EasingStyle.Quart, Enum.EasingDirection.Out)
				Tween(Stroke, 0.22, { Transparency = 0.35 }, Enum.EasingStyle.Quart, Enum.EasingDirection.Out)
				Tween(BrandBadge, 0.22, { BackgroundTransparency = 0 }, Enum.EasingStyle.Quart, Enum.EasingDirection.Out)
				Tween(BrandText, 0.22, { TextTransparency = 0 }, Enum.EasingStyle.Quart, Enum.EasingDirection.Out)
				Tween(LogoIcon, 0.22, { ImageTransparency = 0 }, Enum.EasingStyle.Quart, Enum.EasingDirection.Out)
				for _, descendant in ipairs(self.WatermarkFrame:GetDescendants()) do
					if descendant:IsA("TextLabel") then
						Tween(descendant, 0.22, { TextTransparency = 0 }, Enum.EasingStyle.Quart, Enum.EasingDirection.Out)
					elseif descendant:IsA("Frame") and descendant ~= self.WatermarkFrame and descendant ~= BrandBadge and not descendant.Name:find("Container") and not descendant.Name:find("Wrapper") then
						Tween(descendant, 0.22, { BackgroundTransparency = 0.4 }, Enum.EasingStyle.Quart, Enum.EasingDirection.Out)
					end
				end
			end
		else
			if not self.WatermarkFrame.Visible then return end
			if instant or self.IsLoadingConfig then
				WmScale.Scale = 0.85
				self.WatermarkFrame.BackgroundTransparency = 1
				Stroke.Transparency = 1
				BrandBadge.BackgroundTransparency = 1
				BrandText.TextTransparency = 1
				LogoIcon.ImageTransparency = 1
				self.WatermarkFrame.Visible = false
				if self.WatermarkGui then self.WatermarkGui.Enabled = false end
			else
				Tween(WmScale, 0.18, { Scale = 0.85 }, Enum.EasingStyle.Quart, Enum.EasingDirection.In)
				Tween(self.WatermarkFrame, 0.18, { BackgroundTransparency = 1 }, Enum.EasingStyle.Quart, Enum.EasingDirection.In)
				Tween(Stroke, 0.18, { Transparency = 1 }, Enum.EasingStyle.Quart, Enum.EasingDirection.In)
				Tween(BrandBadge, 0.18, { BackgroundTransparency = 1 }, Enum.EasingStyle.Quart, Enum.EasingDirection.In)
				Tween(BrandText, 0.18, { TextTransparency = 1 }, Enum.EasingStyle.Quart, Enum.EasingDirection.In)
				Tween(LogoIcon, 0.18, { ImageTransparency = 1 }, Enum.EasingStyle.Quart, Enum.EasingDirection.In)
				for _, descendant in ipairs(self.WatermarkFrame:GetDescendants()) do
					if descendant:IsA("TextLabel") then
						Tween(descendant, 0.18, { TextTransparency = 1 }, Enum.EasingStyle.Quart, Enum.EasingDirection.In)
					elseif descendant:IsA("Frame") and descendant ~= self.WatermarkFrame then
						Tween(descendant, 0.18, { BackgroundTransparency = 1 }, Enum.EasingStyle.Quart, Enum.EasingDirection.In)
					end
				end
				task.delay(0.18, function()
					if self.WatermarkFrame then
						self.WatermarkFrame.Visible = false
					end
					if not (Library.Flags["Menu_ShowWatermark"] == true) then
						if self.WatermarkGui then self.WatermarkGui.Enabled = false end
					end
				end)
			end
		end
	end

	-- Register Watermark Frame to Acrylic Blur Engine
	AcrylicSystem:AddFrame(WatermarkFrame, function()
		return ScreenGui.Enabled and WatermarkFrame.Visible and WatermarkFrame.BackgroundTransparency < 0.99
	end)

	MakeDraggable(WatermarkFrame, WatermarkFrame)

	local fpsCount = 60
	local lastTime = tick()
	local frameCount = 0

	local renderConn = RunService.RenderStepped:Connect(function()
		frameCount = frameCount + 1
		local now = tick()
		if now - lastTime >= 1 then
			fpsCount = frameCount
			frameCount = 0
			lastTime = now

			local ping = 0
			pcall(function()
				if LocalPlayer and LocalPlayer.GetNetworkPing then
					local netPing = LocalPlayer:GetNetworkPing()
					if netPing and netPing > 0 then
						ping = math.floor(netPing * 1000 + 0.5)
					end
				end
			end)
			if ping <= 0 then
				pcall(function()
					local stats = game:GetService("Stats")
					if stats:FindFirstChild("PerformanceStats") and stats.PerformanceStats:FindFirstChild("Ping") then
						ping = math.floor(stats.PerformanceStats.Ping:GetValue() + 0.5)
					elseif stats:FindFirstChild("Network") and stats.Network:FindFirstChild("ServerStatsItem") and stats.Network.ServerStatsItem:FindFirstChild("Data Ping") then
						ping = math.floor(stats.Network.ServerStatsItem["Data Ping"]:GetValue() + 0.5)
					end
				end)
			end
			if ping <= 0 then
				pcall(function()
					local stats = game:GetService("Stats")
					local pingStr = stats.Network.ServerStatsItem["Data Ping"]:GetValueString()
					local num = tonumber(pingStr:match("%d+%.?%d*"))
					if num then ping = math.floor(num + 0.5) end
				end)
			end
			if ping <= 0 then ping = 24 end

			PingVal.Text = tostring(ping)
			FpsVal.Text = tostring(fpsCount)
			TimeText.Text = os.date("%H:%M")
		end
	end)
	GarbageCollector:AddConnection(renderConn)

	Library:OnThemeChange(function(th)
		WatermarkFrame.BackgroundColor3 = th.WindowBg
		WatermarkFrame.BackgroundTransparency = th.WindowTransparency
		Stroke.Color = th.DropStroke or Color3.fromRGB(48, 48, 56)
		BrandBadge.BackgroundColor3 = th.Accent
		LogoIcon.ImageColor3 = th.Dark or Color3.fromRGB(17, 17, 17)
		BrandText.TextColor3 = th.Dark or Color3.fromRGB(17, 17, 17)
		UserText.TextColor3 = th.Text
		PingVal.TextColor3 = th.Text
		PingUnit.TextColor3 = th.TextDim
		FpsVal.TextColor3 = th.Text
		FpsUnit.TextColor3 = th.TextDim
		TimeText.TextColor3 = th.Text
		div1.BackgroundColor3 = th.DropStroke or Color3.fromRGB(48, 48, 56)
		div2.BackgroundColor3 = th.DropStroke or Color3.fromRGB(48, 48, 56)
		div3.BackgroundColor3 = th.DropStroke or Color3.fromRGB(48, 48, 56)
	end)

	return WatermarkFrame
end

