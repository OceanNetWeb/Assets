		updateSV(colData.Sat, colData.Val)
		updateHue(colData.Hue)

		local dSV, dH = false, false
		svMap.InputBegan:Connect(function(i)
			if i.UserInputType == Enum.UserInputType.MouseButton1 or i.UserInputType == Enum.UserInputType.Touch then
				dSV = true
				local s = math.clamp((i.Position.X - svMap.AbsolutePosition.X) / svMap.AbsoluteSize.X, 0, 1)
				local v = 1 - math.clamp((i.Position.Y - svMap.AbsolutePosition.Y) / svMap.AbsoluteSize.Y, 0, 1)
				updateSV(s, v)
			end
		end)

		hueMap.InputBegan:Connect(function(i)
			if i.UserInputType == Enum.UserInputType.MouseButton1 or i.UserInputType == Enum.UserInputType.Touch then
				dH = true
				local h = math.clamp((i.Position.Y - hueMap.AbsolutePosition.Y) / hueMap.AbsoluteSize.Y, 0, 1)
				updateHue(h)
			end
		end)

		local cEnd = UserInputService.InputEnded:Connect(function(i)
			if i.UserInputType == Enum.UserInputType.MouseButton1 or i.UserInputType == Enum.UserInputType.Touch then
				dSV = false
				dH = false
			end
		end)
		table.insert(popupUISConns, cEnd)

		local cChg = UserInputService.InputChanged:Connect(function(i)
			if i.UserInputType == Enum.UserInputType.MouseMovement or i.UserInputType == Enum.UserInputType.Touch then
				if dSV then
					local s = math.clamp((i.Position.X - svMap.AbsolutePosition.X) / svMap.AbsoluteSize.X, 0, 1)
					local v = 1 - math.clamp((i.Position.Y - svMap.AbsolutePosition.Y) / svMap.AbsoluteSize.Y, 0, 1)
					updateSV(s, v)
				elseif dH then
					local h = math.clamp((i.Position.Y - hueMap.AbsolutePosition.Y) / hueMap.AbsoluteSize.Y, 0, 1)
					updateHue(h)
				end
			end
		end)
		table.insert(popupUISConns, cChg)

		-- Smooth entrance animation (Anchor-Origin Spring Pop-In)
		Tween(pScale, 0.24, { Scale = 1 }, Enum.EasingStyle.Back, Enum.EasingDirection.Out)
		Tween(pickerFrame, 0.22, {
			Position = UDim2.fromOffset(targetRightX, targetY),
			BackgroundTransparency = 0.05
		}, Enum.EasingStyle.Quart, Enum.EasingDirection.Out)
		Tween(pStroke, 0.22, { Transparency = 0.35 }, Enum.EasingStyle.Quart, Enum.EasingDirection.Out)

		local isClosing = false
		local function closeThisPicker()
			if isClosing then return end
			isClosing = true
			cleanupConnections()

			Tween(pScale, 0.18, { Scale = 0.60 }, Enum.EasingStyle.Back, Enum.EasingDirection.In)
			Tween(pStroke, 0.16, { Transparency = 1 }, Enum.EasingStyle.Quart, Enum.EasingDirection.In)
			Tween(pickerFrame, 0.16, {
				BackgroundTransparency = 1
			}, Enum.EasingStyle.Quart, Enum.EasingDirection.In)

			task.delay(0.18, function()
				if pickerFrame and pickerFrame.Parent then
					pickerFrame:Destroy()
				end
			end)
		end

		OpenPopup(pickerFrame, closeThisPicker)
		return pickerFrame
	end

