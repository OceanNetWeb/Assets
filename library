local function ApplyFont(obj, style)
	if not obj then return end
	style = style or "Medium"
	if FontManager.CustomAssetId and FontManager.FontFaceRegular then
		obj.FontFace = (style == "Bold" and FontManager.FontFaceBold) or ((style == "Medium" or style == "SemiBold") and FontManager.FontFaceMedium) or FontManager.FontFaceRegular
	else
		obj.Font = (style == "Bold" and FontManager.FallbackBold) or (style == "Regular" and FontManager.FallbackRegular) or FontManager.FallbackMedium
	end
end

