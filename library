		badge.AutomaticSize = Enum.AutomaticSize.X
		badge.BackgroundColor3 = self:GetTheme().Accent
		badge.BackgroundTransparency = 1
		badge.BorderSizePixel = 0
		badge.Active = true
		badge.Parent = secFrame

		local badgeCorner = Instance.new("UICorner")
		badgeCorner.CornerRadius = UDim.new(0, 4)
		badgeCorner.Parent = badge

		local badgePad = Instance.new("UIPadding")
		badgePad.PaddingLeft = UDim.new(0, 6)
		badgePad.PaddingRight = UDim.new(0, 6)
		badgePad.PaddingTop = UDim.new(0, 1)
		badgePad.PaddingBottom = UDim.new(0, 1)
		badgePad.Parent = badge

		local badgeText = Instance.new("TextLabel")
		badgeText.Name = "Title"
		badgeText.Size = UDim2.fromOffset(0, 16)
		badgeText.AutomaticSize = Enum.AutomaticSize.X
		badgeText.BackgroundTransparency = 1
		ApplyFont(badgeText, "Bold")
		badgeText.Text = titleText
		badgeText.TextSize = 9
		badgeText.TextColor3 = self:GetTheme().Dark or Color3.fromRGB(17, 17, 17)
		badgeText.TextTransparency = 1
		badgeText.TextYAlignment = Enum.TextYAlignment.Center
		badgeText.Parent = badge

		local gridContainer = Instance.new("Frame")
		gridContainer.Name = "GridContainer"
		gridContainer.LayoutOrder = 2
		gridContainer.Size = (gridWidth and gridHeight) and UDim2.fromOffset(gridWidth, gridHeight) or UDim2.fromOffset(0, 0)
		gridContainer.AutomaticSize = (gridWidth and gridHeight) and Enum.AutomaticSize.None or Enum.AutomaticSize.XY
		gridContainer.BackgroundTransparency = 1
		gridContainer.Parent = secFrame

		MakeDraggable(secFrame, secFrame)

		local secObj = {
			Name = name:gsub("Section", ""),
			Frame = secFrame,
			Scale = secScale,
			Badge = badge,
			Text = badgeText,
			Slots = {},
			IsVisible = false,
			AnimToken = 0
		}

		function secObj:SetVisible(shouldShow)
			if self.IsVisible == shouldShow then return end
			self.IsVisible = shouldShow
			self.AnimToken = self.AnimToken + 1
			local token = self.AnimToken

			if shouldShow then
				self.Frame.Visible = true
				Tween(self.Scale, 0.15, { Scale = 1 }, Enum.EasingStyle.Quart, Enum.EasingDirection.Out)
				Tween(self.Badge, 0.15, { BackgroundTransparency = 0 }, Enum.EasingStyle.Quart, Enum.EasingDirection.Out)
				Tween(self.Text, 0.15, { TextTransparency = 0 }, Enum.EasingStyle.Quart, Enum.EasingDirection.Out)
				local selectedList = Library.Flags and Library.Flags["ItemFinder_SelectedItems"]
				for _, slot in ipairs(self.Slots) do
					local slotIcon = slot:FindFirstChild("ItemIcon")
					local slotName = slotIcon and slotIcon.Name
					local nameLabel = slot:FindFirstChild("ItemNameLabel")
					local rawName = slot:GetAttribute("_WantedRawName") or ""
					local isWanted = false
					if type(selectedList) == "table" and rawName ~= "" then
						for _, sel in ipairs(selectedList) do
							if sel == rawName then
								isWanted = true
								break
							end
						end
					end
					if isWanted then
						Tween(slot, 0.15, { BackgroundTransparency = 0.15, BackgroundColor3 = Library:GetTheme().Accent }, Enum.EasingStyle.Quart, Enum.EasingDirection.Out)
						local stroke = slot:FindFirstChildOfClass("UIStroke")
						if stroke then
							Tween(stroke, 0.15, { Transparency = 0, Thickness = 1.5, Color = Library:GetTheme().Accent }, Enum.EasingStyle.Quart, Enum.EasingDirection.Out)
						end
					else
						Tween(slot, 0.15, { BackgroundTransparency = Library:GetTheme().WindowTransparency, BackgroundColor3 = Library:GetTheme().WindowBg }, Enum.EasingStyle.Quart, Enum.EasingDirection.Out)
						local stroke = slot:FindFirstChildOfClass("UIStroke")
						if stroke then
							Tween(stroke, 0.15, { Transparency = 0.5, Thickness = 1 }, Enum.EasingStyle.Quart, Enum.EasingDirection.Out)
						end
					end
				end
			else
				Tween(self.Scale, 0.15, { Scale = 0.85 }, Enum.EasingStyle.Quart, Enum.EasingDirection.In)
				Tween(self.Badge, 0.15, { BackgroundTransparency = 1 }, Enum.EasingStyle.Quart, Enum.EasingDirection.In)
				Tween(self.Text, 0.15, { TextTransparency = 1 }, Enum.EasingStyle.Quart, Enum.EasingDirection.In)
				for _, slot in ipairs(self.Slots) do
					Tween(slot, 0.15, { BackgroundTransparency = 1 }, Enum.EasingStyle.Quart, Enum.EasingDirection.In)
					local stroke = slot:FindFirstChildOfClass("UIStroke")
					if stroke then
						Tween(stroke, 0.15, { Transparency = 1 }, Enum.EasingStyle.Quart, Enum.EasingDirection.In)
					end
				end
				task.delay(0.15, function()
					if self.AnimToken == token and not self.IsVisible then
						self.Frame.Visible = false
					end
				end)
			end
		end

		table.insert(sectionFrames, secObj)
		table.insert(headerBadges, badge)
		table.insert(headerTexts, badgeText)

		return gridContainer, secObj
	end

	-- Default sub-elements visibility
	self.TargetWeaponsEnabled = false
	self.TargetShirtEnabled = false
	self.TargetPantsEnabled = false
	self.TargetArmorEnabled = false

	-- 1. WEAPONS SECTION (3 slots horizontal: 138x44)
	local WepGridContainer, WepSec = createSection("WeaponsSection", UDim2.new(0.5, -572, 0.5, -230), "WEAPONS", 138, 44)
	local WepLayout = Instance.new("UIGridLayout")
	WepLayout.CellSize = UDim2.fromOffset(44, 44)
	WepLayout.CellPadding = UDim2.fromOffset(3, 0)
	WepLayout.FillDirection = Enum.FillDirection.Horizontal
	WepLayout.SortOrder = Enum.SortOrder.LayoutOrder
	WepLayout.Parent = WepGridContainer

	local weaponSlots = {}
	for i = 1, 3 do
		local slot = createSlot(WepGridContainer, "Weapon_" .. tostring(i))
		table.insert(weaponSlots, slot)
		table.insert(WepSec.Slots, slot)
	end

	-- 2. SHIRT SECTION (6 slots: 2 rows of 3 slots, 138x91)
	local ShirtGridContainer, ShirtSec = createSection("ShirtSection", UDim2.new(0.5, -572, 0.5, -162), "SHIRT", 138, 91)
	local ShirtLayout = Instance.new("UIGridLayout")
	ShirtLayout.CellSize = UDim2.fromOffset(44, 44)
	ShirtLayout.CellPadding = UDim2.fromOffset(3, 3)
	ShirtLayout.FillDirection = Enum.FillDirection.Horizontal
	ShirtLayout.SortOrder = Enum.SortOrder.LayoutOrder
	ShirtLayout.Parent = ShirtGridContainer

	local shirtSlots = {}
	for i = 1, 6 do
		local slot = createSlot(ShirtGridContainer, "Shirt_" .. tostring(i))
		table.insert(shirtSlots, slot)
		table.insert(ShirtSec.Slots, slot)
	end

	-- 3. PANTS SECTION (6 slots: 2 rows of 3 slots, 138x91)
	local PantsGridContainer, PantsSec = createSection("PantsSection", UDim2.new(0.5, -572, 0.5, -47), "PANTS", 138, 91)
	local PantsLayout = Instance.new("UIGridLayout")
	PantsLayout.CellSize = UDim2.fromOffset(44, 44)
	PantsLayout.CellPadding = UDim2.fromOffset(3, 3)
	PantsLayout.FillDirection = Enum.FillDirection.Horizontal
	PantsLayout.SortOrder = Enum.SortOrder.LayoutOrder
	PantsLayout.Parent = PantsGridContainer

	local pantsSlots = {}
	for i = 1, 6 do
		local slot = createSlot(PantsGridContainer, "Pants_" .. tostring(i))
		table.insert(pantsSlots, slot)
		table.insert(PantsSec.Slots, slot)
	end

	-- 4. ARMOR SECTION (3 slots vertical: 44x138)
	local ArmorGridContainer, ArmorSec = createSection("ArmorSection", UDim2.new(0.5, -522, 0.5, -230), "ARMOR", 44, 138)
	local ArmorLayout = Instance.new("UIListLayout")
	ArmorLayout.FillDirection = Enum.FillDirection.Vertical
	ArmorLayout.SortOrder = Enum.SortOrder.LayoutOrder
	ArmorLayout.Padding = UDim.new(0, 3)
	ArmorLayout.Parent = ArmorGridContainer

	local armorSlots = {
		Head = createSlot(ArmorGridContainer, "Armor_Head"),
		Chest = createSlot(ArmorGridContainer, "Armor_Chest"),
		Leg = createSlot(ArmorGridContainer, "Armor_Leg")
	}
	table.insert(ArmorSec.Slots, armorSlots.Head)
	table.insert(ArmorSec.Slots, armorSlots.Chest)
	table.insert(ArmorSec.Slots, armorSlots.Leg)

	self.TargetInvSections = {
		Weapons = WepSec.Frame,
		Shirt = ShirtSec.Frame,
		Pants = PantsSec.Frame,
		Armor = ArmorSec.Frame
	}

	local lastInvUpdateTarget = nil
	local lastInvUpdateTime = 0

	function Library:UpdateTargetInventory(targetObj)
		if not self.TargetInventoryFrame or not self.TargetInventoryGui or not self.TargetInventoryGui.Enabled then return end

		local targetPlayer = nil
		if targetObj then
			if targetObj:IsA("Player") and targetObj.Parent == Players then
				targetPlayer = targetObj
			elseif targetObj:IsA("Model") then
				targetPlayer = Players:GetPlayerFromCharacter(targetObj)
				if not targetPlayer then
					local found = Players:FindFirstChild(targetObj.Name)
					if found and found:IsA("Player") then
						targetPlayer = found
					end
				end
			end
		end

		if not targetPlayer and Library.IsOpen then
			targetPlayer = LocalPlayer
		end

		local now = tick()
		if targetPlayer and targetPlayer == lastInvUpdateTarget and (now - lastInvUpdateTime) < 0.15 then
			return
		end
		lastInvUpdateTarget = targetPlayer
		lastInvUpdateTime = now

		local rsPlayers = ReplicatedStorage:FindFirstChild("Players")
		local rsPlayer = (targetPlayer and rsPlayers) and rsPlayers:FindFirstChild(targetPlayer.Name)
		local inv = rsPlayer and rsPlayer:FindFirstChild("Inventory")

		local classifiedWeapons = {}
		local classifiedArmor = { Head = nil, Chest = nil, Leg = nil }
		local classifiedShirt = {}
		local classifiedPants = {}

		if inv then
			for _, child in ipairs(inv:GetChildren()) do
				if child:IsA("ObjectValue") and child.Value then
					local slot = child:GetAttribute("Slot") or child.Name
					if slot == "ItemBack1" then
						classifiedWeapons[1] = child
					elseif slot == "ItemBack2" then
						classifiedWeapons[2] = child
					elseif slot == "ItemHip1" or slot == "ItemHip" then
						classifiedWeapons[3] = child
					elseif slot == "Headware" or slot == "ClothingHeadware" or slot == "Helmet" or slot == "Mask" or slot == "ClothingMask" then
						classifiedArmor.Head = child
					elseif slot == "ChestRig" or slot == "ClothingChestRig" or slot == "Armor" then
						classifiedArmor.Chest = child
					elseif slot == "LegArmor" or slot == "ClothingLegArmor" then
						classifiedArmor.Leg = child
					end
				end
			end

			-- Shirt Slots Parsing
			local shirtObj = inv:FindFirstChild("ClothingShirt") or inv:FindFirstChild("Shirt")
			if not shirtObj then
				for _, c in ipairs(inv:GetChildren()) do
					local s = tostring(c:GetAttribute("Slot") or c.Name)
					if s == "ClothingShirt" or s == "Shirt" then
						shirtObj = c
						break
					end
				end
			end

			if shirtObj then
				local shirtContainer = shirtObj:FindFirstChild("Inventory")
				if not shirtContainer and shirtObj:IsA("ObjectValue") and shirtObj.Value then
					shirtContainer = shirtObj.Value:FindFirstChild("Inventory")
				end
				if not shirtContainer and not shirtObj:IsA("ObjectValue") then
					shirtContainer = shirtObj
				end

				if shirtContainer and shirtContainer ~= inv then
					for _, child in ipairs(shirtContainer:GetChildren()) do
						if child:IsA("ObjectValue") and child.Value then
							local slotAttr = child:GetAttribute("Slot") or child.Name
							local num = _slotNumberLookup[slotAttr] or tonumber(slotAttr) or tonumber((tostring(slotAttr):match("%d+")))
							if num and num >= 1 and num <= 6 then
								classifiedShirt[num] = child
							end
						end
					end
				end
			end

			-- Pants Slots Parsing
			local pantsObj = inv:FindFirstChild("ClothingPants") or inv:FindFirstChild("Pants")
			if not pantsObj then
				for _, c in ipairs(inv:GetChildren()) do
					local s = tostring(c:GetAttribute("Slot") or c.Name)
					if s == "ClothingPants" or s == "Pants" then
						pantsObj = c
						break
					end
				end
			end

			if pantsObj then
				local pantsContainer = pantsObj:FindFirstChild("Inventory")
				if not pantsContainer and pantsObj:IsA("ObjectValue") and pantsObj.Value then
					pantsContainer = pantsObj.Value:FindFirstChild("Inventory")
				end
				if not pantsContainer and not pantsObj:IsA("ObjectValue") then
					pantsContainer = pantsObj
				end

				if pantsContainer and pantsContainer ~= inv then
					for _, child in ipairs(pantsContainer:GetChildren()) do
						if child:IsA("ObjectValue") and child.Value then
							local slotAttr = child:GetAttribute("Slot") or child.Name
							local num = _slotNumberLookup[slotAttr] or tonumber(slotAttr) or tonumber((tostring(slotAttr):match("%d+")))
							if num and num >= 1 and num <= 6 then
								classifiedPants[num] = child
							end
						end
					end
				end
			end
		end

		renderSlot(weaponSlots[1], ResolveItemInfo(classifiedWeapons[1]), true)
		renderSlot(weaponSlots[2], ResolveItemInfo(classifiedWeapons[2]), true)
		renderSlot(weaponSlots[3], ResolveItemInfo(classifiedWeapons[3]), true)

		for i = 1, 6 do
			renderSlot(shirtSlots[i], ResolveItemInfo(classifiedShirt[i]), false)
			renderSlot(pantsSlots[i], ResolveItemInfo(classifiedPants[i]), false)
		end

		renderSlot(armorSlots.Head, ResolveItemInfo(classifiedArmor.Head), true)
		renderSlot(armorSlots.Chest, ResolveItemInfo(classifiedArmor.Chest), true)
		renderSlot(armorSlots.Leg, ResolveItemInfo(classifiedArmor.Leg), true)
	end

	function Library:SetTargetInventoryVisible(state)
		if not self.TargetInventoryFrame or not self.TargetInventoryGui then return end

		if state then
			self.TargetInventoryGui.Enabled = true
			self.TargetInventoryFrame.Visible = true
		end

		for _, sec in ipairs(sectionFrames) do
			local secEnabled = (self["Target" .. sec.Name .. "Enabled"] ~= false)
			local shouldShowSec = state and secEnabled
			sec:SetVisible(shouldShowSec)
		end

		if not state then
			task.delay(0.16, function()
				local shouldStay = (self.TargetInventoryEnabled ~= false) and (Library.IsOpen or _G.SilentAimTargetObject ~= nil)
				if not shouldStay then
					if self.TargetInventoryFrame then self.TargetInventoryFrame.Visible = false end
					if self.TargetInventoryGui then self.TargetInventoryGui.Enabled = false end
				end
			end)
		end
	end

	Library:OnThemeChange(function(th)
		for _, b in ipairs(headerBadges) do
			b.BackgroundColor3 = th.Accent
		end
		for _, t in ipairs(headerTexts) do
			t.TextColor3 = th.Dark or Color3.fromRGB(17, 17, 17)
		end
		for _, slot in ipairs(allSlotFrames) do
			slot.BackgroundColor3 = th.WindowBg
			slot.BackgroundTransparency = th.WindowTransparency
			local stroke = slot:FindFirstChildOfClass("UIStroke")
			if stroke then
				stroke.Color = th.DropStroke or Color3.fromRGB(48, 48, 56)
			end
		end
	end)

	return TargetInvMaster
end

