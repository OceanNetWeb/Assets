				end)
			end
		end

		if count == 0 then
			local NoRes = Instance.new("TextLabel")
			NoRes.Size = UDim2.new(1, 0, 0, 36)
			NoRes.BackgroundTransparency = 1
			ApplyFont(NoRes, "Medium")
