						local function UpdateModeVisuals(instant)
							local thAccent = Library:GetTheme().Accent
							local thText = Library:GetTheme().Text
							for mName, elem in pairs(modeElements) do
								local isSel = (mode == mName)
								local targetCheckTrans = isSel and 0 or 1
								local targetCheckPos = isSel and UDim2.new(0, 5, 0.5, -5.5) or UDim2.new(0, 2, 0.5, -5.5)
								local targetLabelPos = isSel and UDim2.fromOffset(20, 0) or UDim2.fromOffset(8, 0)
								local targetColor = isSel and thAccent or thText
								local targetBgTrans = isSel and 0.8 or 1

								elem.Check:SetAttribute("OrigImgTrans", targetCheckTrans)

								if instant then
									elem.Check.ImageTransparency = targetCheckTrans
									elem.Check.Position = targetCheckPos
									elem.Check.ImageColor3 = thAccent
									elem.Label.Position = targetLabelPos
									elem.Label.TextColor3 = targetColor
									elem.Btn.BackgroundTransparency = targetBgTrans
									elem.Btn.BackgroundColor3 = thAccent
								else
									Tween(elem.Check, 0.18, {
										ImageTransparency = targetCheckTrans,
										Position = targetCheckPos,
										ImageColor3 = thAccent
									}, Enum.EasingStyle.Quart, Enum.EasingDirection.Out)
									Tween(elem.Label, 0.18, {
										Position = targetLabelPos,
										TextColor3 = targetColor
									}, Enum.EasingStyle.Quart, Enum.EasingDirection.Out)
									Tween(elem.Btn, 0.18, {
										BackgroundTransparency = targetBgTrans,
										BackgroundColor3 = thAccent
									}, Enum.EasingStyle.Quart, Enum.EasingDirection.Out)
								end
							end
						end

