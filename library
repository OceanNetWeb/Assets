			NoRes.TextColor3 = Library:GetTheme().TextDim
			NoRes.TextSize = 11
			NoRes.ZIndex = 113
			NoRes.Parent = SrList
			return 1
		end

		return count
	end

	function CloseSearchDropdown()
		if not isSearchOpen then return end
		isSearchOpen = false
		SearchInput:ReleaseFocus()
		Tween(SearchDropdown, 0.18, { Size = UDim2.new(0, subtabsWidth, 0, 0) }, Enum.EasingStyle.Quart, Enum.EasingDirection.In)
		task.delay(0.18, function()
