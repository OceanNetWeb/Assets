			-- Animated 60FPS Clean Chevron-Down Indicator when content can be scrolled down
			local function SetupScrollIndicator(column, parentView, xPos)
				column.ScrollBarThickness = 0
				column.ScrollBarImageTransparency = 1

				local ArrowIcon = Instance.new("ImageLabel")
				ArrowIcon.Name = "ScrollChevron"
				ArrowIcon.Size = UDim2.fromOffset(13, 13)
				ArrowIcon.Position = UDim2.new(0, xPos + (colWidth / 2), 1, -16)
				ArrowIcon.AnchorPoint = Vector2.new(0.5, 0.5)
				ArrowIcon.BackgroundTransparency = 1
				ArrowIcon.Image = "rbxassetid://10709790948" -- lucide-chevron-down
				ArrowIcon.ImageColor3 = currentTheme.Accent
				ArrowIcon.ImageTransparency = 1
				ArrowIcon.ZIndex = 41
				ArrowIcon.Visible = false
				ArrowIcon.Parent = parentView

				local visAlpha = 0
				local renderConn = RunService.RenderStepped:Connect(function(dt)
					if not parentView.Visible or not Library.IsOpen then return end
					local maxScroll = column.AbsoluteCanvasSize.Y - column.AbsoluteWindowSize.Y
					local hasMoreDown = (maxScroll > 6) and (column.CanvasPosition.Y < maxScroll - 6)
					local targetAlpha = hasMoreDown and 1 or 0
					visAlpha = visAlpha + (targetAlpha - visAlpha) * math.clamp(dt * 14, 0, 1)

					if visAlpha > 0.01 then
						local t = os.clock() * 4.5
						local bob = math.sin(t) * 3
						ArrowIcon.Position = UDim2.new(0, xPos + (colWidth / 2), 1, -16 + bob)
						ArrowIcon.ImageTransparency = 1 - (visAlpha * 0.75)
						ArrowIcon.Visible = true
					else
						ArrowIcon.Visible = false
					end
				end)
				GarbageCollector:AddConnection(renderConn)

				Library:OnThemeChange(function(th)
					ArrowIcon.ImageColor3 = th.Accent
				end)
			end

			SetupScrollIndicator(LeftColumn, SubtabView, 0)
			SetupScrollIndicator(RightColumn, SubtabView, colWidth + colGap)

			local SubtabObj = {
				Name = subtabName,
				Width = 60,
				Button = SubtabBtn,
				SlotBg = SubtabSlotBg,
				ActiveFill = ActiveFill,
				Icon = SubtabIcon,
				Title = SubtabTitle,
				View = SubtabView,
				LeftColumn = LeftColumn,
				RightColumn = RightColumn
			}

			table.insert(self.Subtabs, SubtabObj)
			TabObj:RecalculateSubtabs()

			if isFirstSubtab then
				TabObj.ActiveSubtab = SubtabObj
			end

			function SubtabObj:Select(instant)
				CloseAllPopups()
				for _, st in ipairs(TabObj.Subtabs) do
					if st ~= SubtabObj then
						st.View.Visible = false
						if instant then
							if activeTweens[st.Icon] then pcall(function() activeTweens[st.Icon]:Cancel() end); activeTweens[st.Icon] = nil end
							if activeTweens[st.Title] then pcall(function() activeTweens[st.Title]:Cancel() end); activeTweens[st.Title] = nil end
							if activeTweens[st.ActiveFill] then pcall(function() activeTweens[st.ActiveFill]:Cancel() end); activeTweens[st.ActiveFill] = nil end
							if activeTweens[st.SlotBg] then pcall(function() activeTweens[st.SlotBg]:Cancel() end); activeTweens[st.SlotBg] = nil end

							st.Icon.ImageColor3 = Library:GetTheme().TextDim
							if st.Title then st.Title.TextColor3 = Library:GetTheme().TextDim end
							if st.ActiveFill then
								st.ActiveFill.BackgroundTransparency = 1
								st.ActiveFill:SetAttribute("OrigBgTrans", 1)
								st.ActiveFill.Size = UDim2.fromScale(0.85, 0.85)
							end
							if st.SlotBg then
								st.SlotBg.BackgroundTransparency = 0.25
								st.SlotBg:SetAttribute("OrigBgTrans", 0.25)
							end
						else
							Tween(st.Icon, 0.18, { ImageColor3 = Library:GetTheme().TextDim })
							if st.Title then Tween(st.Title, 0.18, { TextColor3 = Library:GetTheme().TextDim }) end
							if st.ActiveFill then
								st.ActiveFill:SetAttribute("OrigBgTrans", 1)
								Tween(st.ActiveFill, 0.18, { BackgroundTransparency = 1, Size = UDim2.fromScale(0.85, 0.85) }, Enum.EasingStyle.Quart, Enum.EasingDirection.Out)
							end
							if st.SlotBg then
