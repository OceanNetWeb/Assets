	function OpenSearchDropdown()
		if isSearchOpen then return end
		CloseAllPopups()
		isSearchOpen = true
		SearchDropdown.Visible = true
		SearchDropdown.Size = UDim2.new(0, subtabsWidth, 0, 0)
		OpenPopup(SearchDropdown, CloseSearchDropdown)

		local count = RenderSearchResults()
		local targetH = math.min(topbarHeight + 1 + count * 36 + 10, 220)
		Tween(SearchDropdown, 0.22, { Size = UDim2.new(0, subtabsWidth, 0, targetH) }, Enum.EasingStyle.Quart, Enum.EasingDirection.Out)
		SearchInput:CaptureFocus()
