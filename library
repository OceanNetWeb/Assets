							MBtn.BackgroundTransparency = isSel and 0.8 or 1
							MBtn.Text = ""
							MBtn.AutoButtonColor = false
							MBtn.ZIndex = 161
							MBtn.Parent = ModePopup

							local Mc = Instance.new("UICorner")
							Mc.CornerRadius = UDim.new(0, 4)
							Mc.Parent = MBtn

							local CheckIcon = Instance.new("ImageLabel")
							CheckIcon.Name = "Check"
							CheckIcon.Size = UDim2.fromOffset(11, 11)
							CheckIcon.Position = isSel and UDim2.new(0, 5, 0.5, -5.5) or UDim2.new(0, 2, 0.5, -5.5)
							CheckIcon.BackgroundTransparency = 1
							CheckIcon.Image = Library.Icons.Check
							CheckIcon.ImageColor3 = Library:GetTheme().Accent
							CheckIcon.ImageTransparency = isSel and 0 or 1
							CheckIcon:SetAttribute("OrigImgTrans", isSel and 0 or 1)
							CheckIcon.ZIndex = 162
							CheckIcon.Parent = MBtn

							local MLabel = Instance.new("TextLabel")
							MLabel.Name = "Label"
							MLabel.Size = UDim2.new(1, -22, 1, 0)
