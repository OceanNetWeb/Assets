				TabButton.Position = UDim2.new(0, 5, 1, -31 - (bottomOffset - 1) * 31)
				TabButton.Parent = TabCard
			else
				TabButton.LayoutOrder = topIndex
				TabButton.Parent = TabButtonsList
			end

			local TabBtnCorner = Instance.new("UICorner")
			TabBtnCorner.CornerRadius = UDim.new(0, 6)
			TabBtnCorner.Parent = TabButton

			TabBtnIcon = Instance.new("ImageLabel")
			TabBtnIcon.Name = "Icon"
			TabBtnIcon.Size = UDim2.fromOffset(16, 16)
			TabBtnIcon.Position = UDim2.fromScale(0.5, 0.5)
			TabBtnIcon.AnchorPoint = Vector2.new(0.5, 0.5)
			TabBtnIcon.BackgroundTransparency = 1
			TabBtnIcon.ScaleType = Enum.ScaleType.Fit
			TabBtnIcon.Image = iconAsset
			TabBtnIcon.ImageColor3 = isFirstVisibleTab and currentTheme.Dark or currentTheme.TextDim
			TabBtnIcon.ZIndex = 3
			TabBtnIcon.Parent = TabButton
		end

		local TabView = Instance.new("Frame")
		TabView.Name = "TabView_" .. tabName
		TabView.Size = UDim2.fromScale(1, 1)
		TabView.BackgroundTransparency = 1
		TabView.Visible = isFirstVisibleTab
		TabView.Parent = Body

		local TabObj = {
			Name = tabName,
			Index = tabIndex,
			TopIndex = topIndex,
			Button = TabButton,
			Icon = TabBtnIcon,
			View = TabView,
			Subtabs = {},
			ActiveSubtab = nil,
			IsHidden = isHiddenFromSidebar,
			IsBottom = isBottom,
			BottomOffset = bottomOffset
		}

		table.insert(self.Tabs, TabObj)

		if isFirstVisibleTab then
			Window.ActiveTab = TabObj
			TabPill.Position = UDim2.fromOffset(5, 5)
			TabPill.BackgroundTransparency = 0
		end

		function TabObj:Select(instant)
			if not instant and Window.ActiveTab == TabObj then return end
			CloseAllPopups()

			if Window.ActiveTab and Window.ActiveTab ~= TabObj then
				if Window.ActiveTab.Icon then
					if instant then
						Window.ActiveTab.Icon.ImageColor3 = Library:GetTheme().TextDim
					else
						Tween(Window.ActiveTab.Icon, 0.2, { ImageColor3 = Library:GetTheme().TextDim })
					end
				end
				Window.ActiveTab.View.Visible = false
			end

			Window.ActiveTab = TabObj
			TabView.Visible = true

			if isHiddenFromSidebar then
				Tween(SettingsBtn, 0.2, { BackgroundColor3 = Library:GetTheme().Accent, BackgroundTransparency = 0 })
				Tween(SettingsIcon, 0.2, { ImageColor3 = Library:GetTheme().Dark })
				if instant then
					TabPill.BackgroundTransparency = 1
				else
					Tween(TabPill, 0.2, { BackgroundTransparency = 1 })
				end
			else
				Tween(SettingsBtn, 0.2, { BackgroundColor3 = Library:GetTheme().Elevated, BackgroundTransparency = 1 })
				Tween(SettingsIcon, 0.2, { ImageColor3 = Library:GetTheme().TextDim })

				local targetPillPos
				if isBottom then
					targetPillPos = UDim2.new(0, 5, 1, -31 - (bottomOffset - 1) * 31)
				else
					local idx = TabObj.TopIndex or 1
					targetPillPos = UDim2.fromOffset(5, 5 + (idx - 1) * 31)
				end

				TabPill.BackgroundColor3 = Library:GetTheme().Accent

				if instant or TabPill.BackgroundTransparency >= 0.5 then
					TabPill.Position = targetPillPos
					TabPill.BackgroundTransparency = 0
					if TabBtnIcon then
						TabBtnIcon.ImageColor3 = Library:GetTheme().Dark
					end
				else
					Tween(TabPill, 0.2, { BackgroundTransparency = 0, BackgroundColor3 = Library:GetTheme().Accent })
					if TabBtnIcon then
						Tween(TabBtnIcon, 0.2, { ImageColor3 = Library:GetTheme().Dark })
					end
					Tween(TabPill, 0.25, {
						Position = targetPillPos
					}, Enum.EasingStyle.Quart, Enum.EasingDirection.Out)
				end
			end

			for _, t in ipairs(Window.Tabs) do
				for _, st in ipairs(t.Subtabs) do
					st.Button.Visible = (t == TabObj)
				end
			end

			TabObj:RecalculateSubtabs()

			if TabObj.ActiveSubtab then
				TabObj.ActiveSubtab:Select(true)
			elseif #TabObj.Subtabs > 0 then
				TabObj.Subtabs[1]:Select(true)
			end
		end

		if TabButton then
			TabButton.MouseButton1Click:Connect(function()
				if Window.ActiveTab == TabObj then return end
				TabObj:Select()
			end)
		end

		function TabObj:RecalculateSubtabs()
			local count = #self.Subtabs
			if count == 0 then return end
			local totalW = subtabsWidth - 8
			local gap = 4
			local eachW = math.floor((totalW - (gap * (count - 1))) / count)
			eachW = math.max(eachW, 20)

			for _, st in ipairs(self.Subtabs) do
				st.Width = eachW
				st.Button.Size = UDim2.fromOffset(eachW, 22)
			end
		end

		Library:OnThemeChange(function(th)
			TabPill.BackgroundColor3 = th.Accent
			if Window.ActiveTab == TabObj then
				if TabBtnIcon then TabBtnIcon.ImageColor3 = th.Dark end
			else
				if TabBtnIcon then TabBtnIcon.ImageColor3 = th.TextDim end
			end
		end)

