					SliderCard.Parent = SectionCard

					hookDepends(dependsOn, SliderCard, origH)

					local AnimClip = Instance.new("Frame")
					AnimClip.Name = "AnimClip"
					AnimClip.Position = UDim2.new(0, -4, 0, 0)
					AnimClip.Size = UDim2.new(1, 8, 1, 0)
					AnimClip.BackgroundTransparency = 1
					AnimClip.ClipsDescendants = true
					AnimClip.Parent = SliderCard

					local TopRow = Instance.new("Frame")
					TopRow.Name = "TopRow"
					TopRow.Position = UDim2.new(0, 4, 0, 0)
					TopRow.Size = UDim2.new(1, -8, 0, 16)
					TopRow.BackgroundTransparency = 1
					TopRow.Parent = AnimClip

					local Title = Instance.new("TextLabel")
					Title.Name = "Title"
					Title.Size = UDim2.new(1, -60, 1, 0)
					Title.BackgroundTransparency = 1
					ApplyFont(Title, "Medium")
					Title.Text = name
					Title.TextColor3 = Library:GetTheme().Text
					Title.TextSize = 12
					Title.TextXAlignment = Enum.TextXAlignment.Left
					Title.Parent = TopRow

					local ValueLabel = Instance.new("TextBox")
					ValueLabel.Name = "ValueLabel"
					ValueLabel.Size = UDim2.new(0, 60, 1, 0)
					ValueLabel.Position = UDim2.new(1, -60, 0, 0)
					ValueLabel.BackgroundTransparency = 1
					ApplyFont(ValueLabel, "Regular")
					ValueLabel.Text = tostring(value) .. suffix
					ValueLabel.TextColor3 = Library:GetTheme().TextDim
					ValueLabel.TextSize = 11
					ValueLabel.TextXAlignment = Enum.TextXAlignment.Right
					ValueLabel.ClearTextOnFocus = false
					ValueLabel.PlaceholderText = ""
					ValueLabel.Parent = TopRow

					local Track = Instance.new("Frame")
					Track.Name = "Track"
					Track.Size = UDim2.new(1, -8, 0, 6)
					Track.Position = UDim2.new(0, 4, 0, 22)
					Track.BackgroundColor3 = Library:GetTheme().Elevated
					Track.BackgroundTransparency = Library:GetTheme().ElevatedTransparency
					Track.Parent = AnimClip

					local TrackCorner = Instance.new("UICorner")
					TrackCorner.CornerRadius = UDim.new(1, 0)
					TrackCorner.Parent = Track

					local TrackStroke = Instance.new("UIStroke")
					TrackStroke.Name = "TrackStroke"
					TrackStroke.Color = Library:GetTheme().DropStroke or Color3.fromRGB(48, 48, 54)
					TrackStroke.Transparency = 0.35
					TrackStroke:SetAttribute("OrigStrokeTrans", 0.35)
					TrackStroke.Thickness = 1
					TrackStroke.ApplyStrokeMode = Enum.ApplyStrokeMode.Border
					TrackStroke.Parent = Track

					local Fill = Instance.new("Frame")
					Fill.Name = "Fill"
					Fill.Size = UDim2.fromScale((max == min) and 0 or math.clamp((value - min) / (max - min), 0, 1), 1)
					Fill.BackgroundColor3 = Library:GetTheme().Accent
					Fill.Parent = Track

					local FillCorner = Instance.new("UICorner")
					FillCorner.CornerRadius = UDim.new(1, 0)
					FillCorner.Parent = Fill

					local function SetVal(newVal)
						local rawNum = tonumber(newVal)
						if rawNum then
							if precise then
								value = math.floor(rawNum * 100) / 100
							else
								value = math.floor(rawNum + 0.5)
							end
							value = math.clamp(value, min, max)
						else
							value = math.clamp(tonumber(newVal) or min, min, max)
						end
						Library.Flags[flag] = value
						local relX = (max == min) and 0 or math.clamp((value - min) / (max - min), 0, 1)
						if not ValueLabel:IsFocused() then
							ValueLabel.Text = tostring(value) .. suffix
						end
						callback(value)
						Tween(Fill, 0.15, { Size = UDim2.fromScale(relX, 1) }, Enum.EasingStyle.Quart, Enum.EasingDirection.Out)
					end

					local function Update(inputPos)
						local relX = math.clamp((inputPos.X - Track.AbsolutePosition.X) / Track.AbsoluteSize.X, 0, 1)
						local rawVal = min + (max - min) * relX
						if precise then
							value = math.floor(rawVal * 100) / 100
						else
							value = math.floor(rawVal + 0.5)
						end
						
						Library.Flags[flag] = value
						ValueLabel.Text = tostring(value) .. suffix
						callback(value)

						Fill.Size = UDim2.fromScale(relX, 1)
					end

					local function ApplyTyped()
						local txt = ValueLabel.Text:gsub("%s+", "")
						if txt == "" then
							ValueLabel.Text = tostring(value) .. suffix
						else
							local match = txt:match("[%-+]?%d+%.?%d*")
							local num = tonumber(match or txt)
							if num then
								SetVal(num)
							else
								ValueLabel.Text = tostring(value) .. suffix
							end
						end
						ValueLabel.TextColor3 = Library:GetTheme().TextDim
					end

					ValueLabel.Focused:Connect(function()
						ValueLabel.Text = ""
						ValueLabel.TextColor3 = Library:GetTheme().Text
					end)

					ValueLabel.FocusLost:Connect(function()
						ApplyTyped()
					end)

					ValueLabel.ReturnPressedFromOnScreenKeyboard:Connect(function()
						ApplyTyped()
					end)

					local dragging = false
					Track.InputBegan:Connect(function(input)
						if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
							dragging = true
							Tween(TrackStroke, 0.15, { Transparency = 0.1 })
							Update(input.Position)
						end
					end)

					Track.MouseEnter:Connect(function()
						if not Library.IsOpen or isToggling then return end
						Tween(TrackStroke, 0.15, { Transparency = 0.1 })
					end)

					Track.MouseLeave:Connect(function()
						if not Library.IsOpen or isToggling then return end
						if not dragging then
							Tween(TrackStroke, 0.15, { Transparency = 0.35 })
						end
					end)

					local sConn1 = UserInputService.InputEnded:Connect(function(input)
						if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
							dragging = false
							Tween(TrackStroke, 0.15, { Transparency = 0.35 })
						end
					end)
					GarbageCollector:AddConnection(sConn1)

					local sConn2 = UserInputService.InputChanged:Connect(function(input)
						if dragging and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
							Update(input.Position)
						end
					end)
					GarbageCollector:AddConnection(sConn2)

					Library:OnThemeChange(function(th)
						Title.TextColor3 = th.Text
						ValueLabel.TextColor3 = ValueLabel:IsFocused() and th.Text or th.TextDim
						Track.BackgroundColor3 = th.Elevated
						TrackStroke.Color = th.DropStroke or Color3.fromRGB(48, 48, 54)
						Fill.BackgroundColor3 = th.Accent
					end)

					Library.ControlSetters[flag] = SetVal

					table.insert(Library.SearchRegistry, {
						Name = name,
						Category = sectionName,
						Tab = TabObj,
						Subtab = SubtabObj,
						Element = SliderCard
					})

					return {
						Set = SetVal,
						Get = function() return value end
					}
				end

