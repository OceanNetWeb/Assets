local activeTweens = {}
local function Tween(object, duration, properties, style, direction)
	if not object then return nil end
	local existing = activeTweens[object]
	if existing then
		pcall(function() existing:Cancel() end)
		activeTweens[object] = nil
	end
	style = style or Enum.EasingStyle.Quart
	direction = direction or Enum.EasingDirection.Out
	local tweenInfo = TweenInfo.new(duration, style, direction)
	local tween = TweenService:Create(object, tweenInfo, properties)
	activeTweens[object] = tween
	tween.Completed:Connect(function()
		if activeTweens[object] == tween then
			activeTweens[object] = nil
		end
	end)
	tween:Play()
	return tween
end

local function RunTracer(start, endp)
	local isEnabled = (VisualEngine and VisualEngine.bullettracers) or (Library.Flags and Library.Flags["Vis_BulletTracers"] == true)
	if not isEnabled or not start or not endp then return end

	local color = (VisualEngine and VisualEngine.bullettracercolor) or (Library.Flags and Library.Flags["Vis_TracerColor"]) or Color3.fromRGB(255, 255, 255)
	local lifeTime = (VisualEngine and VisualEngine.bullettracerlife) or (Library.Flags and Library.Flags["Vis_TracerLife"]) or 1.5

	local beam = Instance.new("Beam")
	beam.Name, beam.Parent = "EphemeraTracerBeam", workspace

	local startpart = Instance.new("Part")
	startpart.Name, startpart.Transparency, startpart.Position, startpart.Anchored, startpart.Size = "TracerStart", 1, start, true, Vector3.new(0.01, 0.01, 0.01)
	startpart.CanCollide, startpart.Parent = false, workspace

	local endpart = Instance.new("Part")
	endpart.Name, endpart.Transparency, endpart.Position, endpart.Anchored, endpart.Size = "TracerEnd", 1, endp, true, Vector3.new(0.01, 0.01, 0.01)
	endpart.CanCollide, endpart.CanQuery, endpart.CanTouch, endpart.CastShadow, endpart.Parent = false, false, false, false, workspace

	beam.Attachment0, beam.Attachment1 = Instance.new("Attachment", startpart), Instance.new("Attachment", endpart)
	beam.Color, beam.Width0, beam.Width1, beam.FaceCamera = ColorSequence.new(color, color), 0.3, 0.3, true
	beam.Transparency, beam.LightEmission = NumberSequence.new(0), 1
	beam.Texture, beam.TextureSpeed, beam.TextureLength = "http://www.roblox.com/asset/?id=131326755401058", 3, math.max((endp - start).Magnitude, 1)

	local fadeDuration = math.min(lifeTime * 0.5, 0.5)
	local solidDuration = math.max(lifeTime - fadeDuration, 0.05)

	task.spawn(function()
		task.wait(solidDuration)
		local fadeStart, startWidth = tick(), beam.Width0
		while true do
			local progress = math.clamp((tick() - fadeStart) / fadeDuration, 0, 1)
			if not beam or not beam.Parent then break end
			local alpha = progress * progress
			beam.Transparency = NumberSequence.new(alpha)
			beam.Width0, beam.Width1 = startWidth * (1 - progress * 0.6), startWidth * (1 - progress * 0.6)
			if progress >= 1 then break end
			RunService.Heartbeat:Wait()
		end
		pcall(function() beam:Destroy(); startpart:Destroy(); endpart:Destroy() end)
	end)
end
_G.Ephemera_RunTracer = RunTracer

