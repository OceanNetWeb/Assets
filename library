				----------------------------------------------------------------
				-- 7. PITCH / CURVE GRAPH (INTERACTIVE DRAGGABLE BEZIER GRAPH)
				----------------------------------------------------------------
				function SectionObj:CreatePitchGraph(pitchConfig)
					pitchConfig = pitchConfig or {}
					local name = pitchConfig.Name or "Pitch"
					local flag = pitchConfig.Flag or name
					local defaultVal = pitchConfig.Default or 0.0
					local callback = pitchConfig.Callback or function() end
					local dependsOn = pitchConfig.DependsOn

					-- Value range [-0.7, 0.7], 0.0 is center arch (normY = 0.50)
					local minVal = -0.7
					local maxVal = 0.7
					local clampedInit = math.clamp(defaultVal, minVal, maxVal)
					local initT = (maxVal - clampedInit) / (maxVal - minVal)
					local currentNormY = 0.14 + (initT * 0.72)
					Library.Flags[flag] = clampedInit
					local dependsOn = pitchConfig.DependsOn
					local origH = 114
					local isDepActive = checkDependsActive(dependsOn)

					local PitchCard = Instance.new("Frame")
					PitchCard.Name = "PitchCard_" .. name
					PitchCard.Size = isDepActive and UDim2.new(1, 0, 0, origH) or UDim2.new(1, 0, 0, 0)
					PitchCard.BackgroundTransparency = 1
					PitchCard.ClipsDescendants = false
					PitchCard.Visible = isDepActive
					PitchCard.Parent = SectionCard

					hookDepends(dependsOn, PitchCard, origH)

					local Title = Instance.new("TextLabel")
					Title.Name = "Title"
					Title.Size = UDim2.new(1, 0, 0, 16)
					Title.BackgroundTransparency = 1
					ApplyFont(Title, "Medium")
					Title.Text = name
					Title.TextColor3 = Library:GetTheme().Text
					Title.TextSize = 12
					Title.TextXAlignment = Enum.TextXAlignment.Left
					Title.Parent = PitchCard

					local GraphBox = Instance.new("Frame")
					GraphBox.Name = "GraphBox"
					GraphBox.Size = UDim2.new(1, 0, 0, 88)
					GraphBox.Position = UDim2.fromOffset(0, 20)
					GraphBox.BackgroundColor3 = Library:GetTheme().Elevated
					GraphBox.BackgroundTransparency = Library:GetTheme().ElevatedTransparency
					GraphBox.ClipsDescendants = true
					GraphBox.Parent = PitchCard

					local GraphCorner = Instance.new("UICorner")
					GraphCorner.CornerRadius = UDim.new(0, 6)
					GraphCorner.Parent = GraphBox

					-- Crisp Procedural Dashed Border
					local DashedBorder = Instance.new("Frame")
					DashedBorder.Name = "DashedBorder"
					DashedBorder.Size = UDim2.fromScale(1, 1)
					DashedBorder.BackgroundTransparency = 1
					DashedBorder.ZIndex = 4
					DashedBorder.Parent = GraphBox

					local dashElements = {}

					local function CreateDashedEdge(isHoriz, isEnd)
						local edge = Instance.new("Frame")
						edge.Name = (isHoriz and "Horiz_" or "Vert_") .. (isEnd and "End" or "Start")
						if isHoriz then
							edge.Size = UDim2.new(1, -8, 0, 1)
							edge.Position = isEnd and UDim2.new(0, 4, 1, -1) or UDim2.new(0, 4, 0, 0)
						else
							edge.Size = UDim2.new(0, 1, 1, -8)
							edge.Position = isEnd and UDim2.new(1, -1, 0, 4) or UDim2.new(0, 0, 0, 4)
						end
						edge.BackgroundTransparency = 1
						edge.ClipsDescendants = true
						edge.Parent = DashedBorder

						local layout = Instance.new("UIListLayout")
						layout.FillDirection = isHoriz and Enum.FillDirection.Horizontal or Enum.FillDirection.Vertical
						layout.Padding = UDim.new(0, 3)
						layout.Parent = edge

						local dashCount = isHoriz and 45 or 20
						for i = 1, dashCount do
							local dash = Instance.new("Frame")
							dash.Name = "Dash"
							dash.Size = isHoriz and UDim2.fromOffset(4, 1) or UDim2.fromOffset(1, 4)
							dash.BackgroundColor3 = Library:GetTheme().DropStroke or Color3.fromRGB(48, 48, 56)
							dash.BorderSizePixel = 0
							dash.Parent = edge
							table.insert(dashElements, dash)
						end
					end

					CreateDashedEdge(true, false) -- Top
					CreateDashedEdge(true, true)  -- Bottom
					CreateDashedEdge(false, false) -- Left
					CreateDashedEdge(false, true)  -- Right

					local SegmentsFolder = Instance.new("Folder")
					SegmentsFolder.Name = "Segments"
					SegmentsFolder.Parent = GraphBox

					local NUM_SEGS = 60
					local segmentFrames = {}

					for i = 1, NUM_SEGS do
						local seg = Instance.new("Frame")
						seg.Name = "Seg_" .. i
						seg.AnchorPoint = Vector2.new(0, 0.5)
						seg.BackgroundColor3 = Color3.fromRGB(190, 190, 200)
						seg.BorderSizePixel = 0
						seg.ZIndex = 2
						seg.Parent = SegmentsFolder

						segmentFrames[i] = seg
					end

					local LeftDot = Instance.new("Frame")
					LeftDot.Name = "LeftDot"
					LeftDot.Size = UDim2.fromOffset(4, 4)
					LeftDot.AnchorPoint = Vector2.new(0.5, 0.5)
					LeftDot.BackgroundColor3 = Color3.fromRGB(150, 150, 160)
					LeftDot.ZIndex = 3
					LeftDot.Parent = GraphBox

					local LdCorner = Instance.new("UICorner")
					LdCorner.CornerRadius = UDim.new(1, 0)
					LdCorner.Parent = LeftDot

					local RightDot = Instance.new("Frame")
					RightDot.Name = "RightDot"
					RightDot.Size = UDim2.fromOffset(4, 4)
					RightDot.AnchorPoint = Vector2.new(0.5, 0.5)
					RightDot.BackgroundColor3 = Color3.fromRGB(150, 150, 160)
					RightDot.ZIndex = 3
					RightDot.Parent = GraphBox

					local RdCorner = Instance.new("UICorner")
					RdCorner.CornerRadius = UDim.new(1, 0)
					RdCorner.Parent = RightDot

					local ControlHandle = Instance.new("Frame")
					ControlHandle.Name = "ControlHandle"
					ControlHandle.Size = UDim2.fromOffset(6, 6)
					ControlHandle.AnchorPoint = Vector2.new(0.5, 0.5)
					ControlHandle.BackgroundColor3 = Color3.fromRGB(225, 225, 235)
					ControlHandle.ZIndex = 5
					ControlHandle.Parent = GraphBox

					local ChCorner = Instance.new("UICorner")
					ChCorner.CornerRadius = UDim.new(1, 0)
					ChCorner.Parent = ControlHandle

					local ChStroke = Instance.new("UIStroke")
					ChStroke.Color = Color3.fromRGB(20, 20, 25)
					ChStroke.Thickness = 1
					ChStroke.Parent = ControlHandle

					local HandleHitbox = Instance.new("TextButton")
					HandleHitbox.Name = "Hitbox"
					HandleHitbox.Size = UDim2.fromOffset(26, 26)
					HandleHitbox.AnchorPoint = Vector2.new(0.5, 0.5)
					HandleHitbox.Position = UDim2.fromScale(0.5, 0.5)
					HandleHitbox.BackgroundTransparency = 1
					HandleHitbox.Text = ""
					HandleHitbox.AutoButtonColor = false
					HandleHitbox.ZIndex = 10
					HandleHitbox.Parent = ControlHandle

					local function RedrawCurve(normY)
						local w = GraphBox.AbsoluteSize.X
						local h = GraphBox.AbsoluteSize.Y
						if w <= 10 or h <= 10 then
							w = 240
							h = 88
						end

						local p0 = Vector2.new(12, h - 14)
						local p2 = Vector2.new(w - 12, h - 14)
						local handlePos = Vector2.new(w * 0.5, normY * h)
						-- Exact control point calculation so curve passes directly through the ball
						local p1 = (2 * handlePos) - (0.5 * (p0 + p2))

						LeftDot.Position = UDim2.fromOffset(p0.X, p0.Y)
						RightDot.Position = UDim2.fromOffset(p2.X, p2.Y)
						ControlHandle.Position = UDim2.fromOffset(handlePos.X, handlePos.Y)

						local prevPoint = p0
						for i = 1, NUM_SEGS do
							local t = i / NUM_SEGS
							local omt = 1 - t
							local curPoint = (omt * omt * p0) + (2 * omt * t * p1) + (t * t * p2)

							local diff = curPoint - prevPoint
							local dist = diff.Magnitude
							local angle = math.deg(math.atan2(diff.Y, diff.X))

							local seg = segmentFrames[i]
							seg.Size = UDim2.fromOffset(math.ceil(dist) + 1.2, 1.5)
							seg.Position = UDim2.fromOffset(prevPoint.X, prevPoint.Y)
							seg.Rotation = angle

							prevPoint = curPoint
						end
					end

					local isDragging = false

					local function UpdateFromY(absY)
						local boxTop = GraphBox.AbsolutePosition.Y
						local boxH = GraphBox.AbsoluteSize.Y
						if boxH <= 0 then boxH = 88 end

						local relY = math.clamp((absY - boxTop) / boxH, 0.14, 0.86)
						currentNormY = relY
						local t = (relY - 0.14) / 0.72
						local val = maxVal - (t * (maxVal - minVal))
						val = math.floor(val * 1000) / 1000
						Library.Flags[flag] = val
						RedrawCurve(currentNormY)
						callback(val)
					end

					HandleHitbox.InputBegan:Connect(function(input)
						if not Library.IsOpen or isToggling then return end
						if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
							isDragging = true
							Tween(ControlHandle, 0.1, { Size = UDim2.fromOffset(8, 8), BackgroundColor3 = Library:GetTheme().Accent })
							UpdateFromY(input.Position.Y)
						end
					end)

					local dragChangedConn = UserInputService.InputChanged:Connect(function(input)
						if isDragging and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
							UpdateFromY(input.Position.Y)
						end
					end)
					GarbageCollector:AddConnection(dragChangedConn)

					local dragEndedConn = UserInputService.InputEnded:Connect(function(input)
						if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
							if isDragging then
								isDragging = false
								Tween(ControlHandle, 0.1, { Size = UDim2.fromOffset(6, 6), BackgroundColor3 = Color3.fromRGB(225, 225, 235) })
							end
						end
					end)
					GarbageCollector:AddConnection(dragEndedConn)

					GraphBox:GetPropertyChangedSignal("AbsoluteSize"):Connect(function()
						RedrawCurve(currentNormY)
					end)

					task.defer(function()
						RedrawCurve(currentNormY)
					end)

					Library:OnThemeChange(function(th)
						GraphBox.BackgroundColor3 = th.Elevated
						GraphBox.BackgroundTransparency = th.ElevatedTransparency
						Title.TextColor3 = th.Text
						for _, d in ipairs(dashElements) do
							d.BackgroundColor3 = th.DropStroke or Color3.fromRGB(48, 48, 56)
						end
						if isDragging then
							ControlHandle.BackgroundColor3 = th.Accent
						end
					end)

					table.insert(Library.SearchRegistry, {
						Name = name,
						Category = sectionName,
						Tab = TabObj,
						Subtab = SubtabObj,
						Element = PitchCard
					})

					local function SetPitchValue(v)
						if typeof(v) ~= "number" then return end
						local val = math.clamp(v, minVal, maxVal)
						local t = (maxVal - val) / (maxVal - minVal)
						currentNormY = 0.14 + (t * 0.72)
						Library.Flags[flag] = val
						RedrawCurve(currentNormY)
						callback(val)
					end

					Library.ControlSetters[flag] = SetPitchValue

					return {
						Set = SetPitchValue,
						Get = function()
							return Library.Flags[flag]
						end
					}
				end

				return SectionObj
			end

			return SubtabObj
		end

		return TabObj
	end

	local cSetEnter = SettingsBtn.MouseEnter:Connect(function()
		if not Library.IsOpen or isToggling then return end
		Tween(SettingsIcon, 0.4, { Rotation = 90 }, Enum.EasingStyle.Quart, Enum.EasingDirection.Out)
	end)
	GarbageCollector:AddConnection(cSetEnter)

	local cSetLeave = SettingsBtn.MouseLeave:Connect(function()
		if not Library.IsOpen or isToggling then return end
		Tween(SettingsIcon, 0.4, { Rotation = 0 }, Enum.EasingStyle.Quart, Enum.EasingDirection.Out)
	end)
	GarbageCollector:AddConnection(cSetLeave)

	local cSetClick = SettingsBtn.MouseButton1Click:Connect(function()
		if Window.SettingsTab and Window.ActiveTab ~= Window.SettingsTab then
			Window.SettingsTab:Select()
		end
	end)
	GarbageCollector:AddConnection(cSetClick)

	return Window
end

