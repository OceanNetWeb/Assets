	_slotNumberLookup["Container_" .. i] = i
	_slotNumberLookup["Container" .. i] = i
	_slotNumberLookup["Item" .. i] = i
	_slotNumberLookup["Item_" .. i] = i
	_slotNumberLookup["Backpack_" .. i] = i
	_slotNumberLookup["Backpack" .. i] = i
	_slotNumberLookup["Bag_" .. i] = i
	_slotNumberLookup["Bag" .. i] = i
