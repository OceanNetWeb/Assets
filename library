function Library:CreateTargetModel(config)
	config = config or {}

	self.TargetHUDEnabled = false
	self.TargetModelEnabled = false

	local ScreenGui = Instance.new("ScreenGui")
	ScreenGui.Name = "Velocity_TargetModel"
	ScreenGui.ResetOnSpawn = false
	ScreenGui.DisplayOrder = 10002
	ScreenGui.Enabled = false
	ScreenGui.Parent = GetSafeGuiParent()
	self.TargetModelGui = ScreenGui
	GarbageCollector:AddInstance(ScreenGui)

	-- Root Container (Размер уменьшен в 1.5 раза: 170x240, расположен ПОД Target HUD)
	local TargetModelFrame = Instance.new("Frame")
	TargetModelFrame.Name = "TargetModelFrame"
	TargetModelFrame.AnchorPoint = Vector2.new(1, 0)
	TargetModelFrame.Position = UDim2.new(0.5, -325, 0.5, -230)
	TargetModelFrame.Size = UDim2.fromOffset(170, 240)
	TargetModelFrame.BackgroundColor3 = self:GetTheme().WindowBg
	TargetModelFrame.BackgroundTransparency = 1
	TargetModelFrame.BorderSizePixel = 0
	TargetModelFrame.Visible = false
	TargetModelFrame.ClipsDescendants = true
	TargetModelFrame.Active = true
	TargetModelFrame.Parent = ScreenGui
	self.TargetModelFrame = TargetModelFrame

	local Corner = Instance.new("UICorner")
	Corner.CornerRadius = UDim.new(0, 8)
	Corner.Parent = TargetModelFrame

	local Stroke = Instance.new("UIStroke")
	Stroke.Color = self:GetTheme().DropStroke or Color3.fromRGB(48, 48, 56)
	Stroke.Transparency = 1
	Stroke.Thickness = 1
	Stroke.ApplyStrokeMode = Enum.ApplyStrokeMode.Border
	Stroke.Parent = TargetModelFrame

	AcrylicSystem:AddFrame(TargetModelFrame, function()
		return ScreenGui.Enabled and TargetModelFrame.Visible and TargetModelFrame.BackgroundTransparency < 0.99
	end)

	local ModelHudScale = Instance.new("UIScale")
	ModelHudScale.Scale = 0.85
	ModelHudScale.Parent = TargetModelFrame

	-- ViewportFrame
	local Viewport = Instance.new("ViewportFrame")
	Viewport.Name = "ModelViewport"
	Viewport.Size = UDim2.new(1, -6, 1, -6)
	Viewport.Position = UDim2.fromScale(0.5, 0.5)
	Viewport.AnchorPoint = Vector2.new(0.5, 0.5)
	Viewport.BackgroundTransparency = 1
	Viewport.Ambient = Color3.fromRGB(200, 200, 200)
	Viewport.LightColor = Color3.fromRGB(255, 255, 255)
	Viewport.LightDirection = Vector3.new(-1, -1.5, -2).Unit
	Viewport.Parent = TargetModelFrame

	local WorldModel = Instance.new("WorldModel")
	WorldModel.Parent = Viewport

	local VpCamera = Instance.new("Camera")
	VpCamera.FieldOfView = 50
	VpCamera.Parent = Viewport
Viewport.CurrentCamera = VpCamera

	local currentTargetModel = nil
	local currentClonedModel = nil
	local activePartPairs = {}
	local childConn = nil
	local childRemConn = nil
	local lastRebuildTime = 0

	local function cleanupClone()
		if childConn then childConn:Disconnect(); childConn = nil end
		if childRemConn then childRemConn:Disconnect(); childRemConn = nil end
		if currentClonedModel then
			currentClonedModel:Destroy()
			currentClonedModel = nil
		end
		activePartPairs = {}
		currentTargetModel = nil
	end

	local function mapClonedParts(origParent, cloneParent)
		for _, origChild in ipairs(origParent:GetChildren()) do
			local cloneChild = cloneParent:FindFirstChild(origChild.Name)
			if cloneChild then
				if origChild:IsA("BasePart") and cloneChild:IsA("BasePart") then
					table.insert(activePartPairs, { clone = cloneChild, orig = origChild })
				end
				mapClonedParts(origChild, cloneChild)
			end
		end
	end

	local lastPartRotTime = 0
	local CF_ROT180 = CFrame.Angles(0, math.pi, 0)
	local CF_CAM_DEFAULT = CFrame.new(Vector3.new(0, 0, 7.8), Vector3.new(0, -0.1, 0))

	function Library:UpdateTargetModel(targetObj)
		if not self.TargetModelFrame or not self.TargetModelGui or not self.TargetModelGui.Enabled or not self.TargetModelFrame.Visible then return end

		local validTarget = targetObj and targetObj:IsA("Model")
		local activeModel = validTarget and targetObj or (Library.IsOpen and LocalPlayer.Character or nil)

		if activeModel and activeModel:IsA("Model") then
			local now = tick()
			local modelChanged = (activeModel ~= currentTargetModel)
			if modelChanged or not currentClonedModel or not currentClonedModel.Parent then
				cleanupClone()
				currentTargetModel = activeModel
				lastRebuildTime = now

				childConn = activeModel.ChildAdded:Connect(function(c)
					if c:IsA("Tool") or c:IsA("Model") or c:IsA("Accessory") or c:IsA("Shirt") or c:IsA("Pants") then
						if tick() - lastRebuildTime > 1.0 then
							if currentClonedModel then
								currentClonedModel:Destroy()
								currentClonedModel = nil
							end
						end
					end
				end)
				childRemConn = activeModel.ChildRemoved:Connect(function(c)
					if c:IsA("Tool") or c:IsA("Model") or c:IsA("Accessory") or c:IsA("Shirt") or c:IsA("Pants") then
						if tick() - lastRebuildTime > 1.0 then
							if currentClonedModel then
								currentClonedModel:Destroy()
								currentClonedModel = nil
							end
						end
					end
				end)

				local prevArch = activeModel.Archivable
				activeModel.Archivable = true
				local clone = activeModel:Clone()
				activeModel.Archivable = prevArch

				if clone then
					for _, d in ipairs(clone:GetDescendants()) do
						if d:IsA("LuaSourceContainer") or d:IsA("Sound") or d:IsA("Highlight") or d:IsA("BillboardGui") or d:IsA("ParticleEmitter") or d:IsA("Beam") or d:IsA("Trail") then
							d:Destroy()
						elseif d:IsA("BasePart") then
							d.CanCollide = false
							d.Anchored = true
							d.CastShadow = false
						end
					end
					activePartPairs = {}
					mapClonedParts(activeModel, clone)
					clone.Parent = WorldModel
					currentClonedModel = clone
				end
			end

			if currentClonedModel and currentTargetModel then
				local root = currentTargetModel:FindFirstChild("HumanoidRootPart") or currentTargetModel.PrimaryPart or currentTargetModel:FindFirstChild("Torso") or currentTargetModel:FindFirstChild("UpperTorso") or currentTargetModel:FindFirstChild("Head")
				if root then
					local rootCf = root.CFrame
					for _, pair in ipairs(activePartPairs) do
						local pClone = pair.clone
						local pOrig = pair.orig
						if pClone and pClone.Parent and pOrig and pOrig.Parent then
							pClone.CFrame = CF_ROT180 * (rootCf:ToObjectSpace(pOrig.CFrame))
						end
					end
				end
				VpCamera.CFrame = CF_CAM_DEFAULT
			end
		else
			if not Library.IsOpen then
				-- Keep during fadeout
			else
				cleanupClone()
			end
		end
	end

	local isHidingTargetModel = false
	local hideModelAnimToken = 0

	function Library:SetTargetModelVisible(state)
		if not self.TargetModelFrame or not self.TargetModelGui then return end

		hideModelAnimToken = hideModelAnimToken + 1
		local currentToken = hideModelAnimToken

		if state then
			isHidingTargetModel = false
			self.TargetModelGui.Enabled = true
			self.TargetModelFrame.Visible = true

			Tween(ModelHudScale, 0.15, { Scale = 1 }, Enum.EasingStyle.Quart, Enum.EasingDirection.Out)
			Tween(TargetModelFrame, 0.15, { BackgroundTransparency = self:GetTheme().WindowTransparency }, Enum.EasingStyle.Quart, Enum.EasingDirection.Out)
			Tween(Stroke, 0.15, { Transparency = 0.35 }, Enum.EasingStyle.Quart, Enum.EasingDirection.Out)
		else
			isHidingTargetModel = true
			Tween(ModelHudScale, 0.15, { Scale = 0.85 }, Enum.EasingStyle.Quart, Enum.EasingDirection.In)
			Tween(TargetModelFrame, 0.15, { BackgroundTransparency = 1 }, Enum.EasingStyle.Quart, Enum.EasingDirection.In)
			Tween(Stroke, 0.15, { Transparency = 1 }, Enum.EasingStyle.Quart, Enum.EasingDirection.In)

			task.delay(0.15, function()
				if hideModelAnimToken == currentToken and isHidingTargetModel then
					if self.TargetModelFrame then self.TargetModelFrame.Visible = false end
					if self.TargetModelGui then self.TargetModelGui.Enabled = false end
					cleanupClone()
					isHidingTargetModel = false
				end
			end)
		end
	end

	MakeDraggable(TargetModelFrame, TargetModelFrame)

	Library:OnThemeChange(function(th)
		Stroke.Color = th.DropStroke or Color3.fromRGB(48, 48, 56)
		TargetModelFrame.BackgroundColor3 = th.WindowBg
		TargetModelFrame.BackgroundTransparency = th.WindowTransparency
	end)

	return TargetModelFrame
end

