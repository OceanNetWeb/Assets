local FolderStructure = { Root = "Ephemera", Configs = "Ephemera/Configs", Fonts = "Ephemera/Fonts", Sounds = "Ephemera/Sounds" }
local function EnsureFolders()
	pcall(function()
		if typeof(makefolder) == "function" and typeof(isfolder) == "function" then
			for _, folder in pairs(FolderStructure) do if not isfolder(folder) then makefolder(folder) end end
		end
	end)
end
EnsureFolders()

local ConfigSystem = { Folder = "Ephemera/Configs", VirtualFS = {} }
local hasFS = (writefile and readfile and isfile and listfiles and makefolder and isfolder) ~= nil

function ConfigSystem:Init() EnsureFolders() end

function ConfigSystem:GetConfigs()
	local list = {}
	if hasFS then
		local success, files = pcall(function() return listfiles(self.Folder) end)
		if success and type(files) == "table" then
			for _, path in ipairs(files) do
				local fileName = path:match("([^/\\]+)%.json$")
				if fileName then table.insert(list, fileName) end
			end
		end
	else
		for name, _ in pairs(self.VirtualFS) do table.insert(list, name) end
	end
	table.sort(list); return list
end

function ConfigSystem:Save(name, data)
	local encoded = HttpService:JSONEncode(data)
	if hasFS then
		EnsureFolders()
		pcall(function() writefile(self.Folder .. "/" .. name .. ".json", encoded) end)
	else
		self.VirtualFS[name] = encoded
	end
end

function ConfigSystem:Load(name)
	local raw = nil
	if hasFS then
		pcall(function()
			local path = self.Folder .. "/" .. name .. ".json"
			if isfile(path) then raw = readfile(path) end
		end)
	else
		raw = self.VirtualFS[name]
	end

	if raw then
		local success, decoded = pcall(function() return HttpService:JSONDecode(raw) end)
		if success and type(decoded) == "table" then return decoded end
	end
	return nil
end

function ConfigSystem:Delete(name)
	if hasFS then
		pcall(function()
			local path = self.Folder .. "/" .. name .. ".json"
			if isfile(path) and delfile then delfile(path) end
		end)
	else
		self.VirtualFS[name] = nil
	end
end

